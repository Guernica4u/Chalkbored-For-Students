  if (ev.hasDoor) s += `<path d="M${doorX} ${gy} v-24 a8 8 0 0 1 16 0 v24 z" fill="#3b3b3b" stroke="#1a1a1a"/><circle cx="${doorX + 12}" cy="${gy - 12}" r="1.3" fill="#ddd"/>`;
