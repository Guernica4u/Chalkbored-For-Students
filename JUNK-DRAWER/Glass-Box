}

/** Play n greedy test games (no learning) vs random, alternating sides. */
function evaluateBrain(brain, games = 200) {
  const task = brain.task, me = { kind: 'brain', brain, learn: false, explore: false }, opp = { kind: 'random' };
  const solvable = task.solvable !== false;
  let w = 0, l = 0, d = 0, opt = 0, tot = 0;
  for (let i = 0; i < games; i++) {
    const side = i & 1;
    const g = new GameSession(task, side ? [opp, me] : [me, opp]);
    while (!g.over) {
      const pi = g.current, x = g.decide(false);
      if (solvable && pi === side) { tot++; if (Solver.isOptimal(task, g.state, x.a)) opt++; }
      g.play(x.a);
    }
    const r = task.reward(g.state, side);
    if (r > 0) w++; else if (r < 0) l++; else d++;
  }
  return { win: w / games, loss: l / games, draw: d / games, optimal: tot ? opt / tot : null, games };
}

class Trainer {
  constructor(brain) {
    this.brain = brain; this.opponent = 'random';
    this.gameCounter = 0; this.gamesThisRun = 0; this.sinceEval = 0;
    this.rewardSum = 0; this.rewardCount = 0; this.lastGame = null;
  }
  opponentPlayer() {
    if (this.opponent === 'perfect') return { kind: 'perfect' };
    if (this.opponent.startsWith('brain:')) {
      const other = App.brains.find(b => 'brain:' + b.id === this.opponent);
      if (other && other.taskId === this.brain.taskId) return { kind: 'brain', brain: other, learn: false, explore: false };
    }
    return { kind: 'random' };
  }
  evalEvery() { return clamp(Math.round(this.brain.stats.gamesPlayed / 60 / 50) * 50, 250, 25000); }
  /** Run n training games synchronously. If recordLast, the last game is fully recorded for replay. */
  runBatch(n, recordLast = false) {
    const b = this.brain, task = b.task;
    for (let i = 0; i < n; i++) {
      const record = recordLast && i === n - 1;
      const me = { kind: 'brain', brain: b, learn: true, explore: true };
      let players, side = 0;
      if (this.opponent === 'self') players = [me, me];
      else { side = this.gameCounter & 1; const opp = this.opponentPlayer(); players = side ? [opp, me] : [me, opp]; }
      this.gameCounter++;
      const g = new GameSession(task, players, { record, observer: b });
      while (!g.over) { const d = g.decide(record); g.play(d.a, record ? d : null); }
      this.rewardSum += task.reward(g.state, side); this.rewardCount++;
      this.gamesThisRun++; this.sinceEval++;
      if (record) this.lastGame = g;
      if (this.sinceEval >= this.evalEvery()) this.checkpoint();
    }
  }
  checkpoint() {
    const ev = evaluateBrain(this.brain, 200);
    this.brain.history.push({ g: this.brain.stats.gamesPlayed, win: ev.win, loss: ev.loss, opt: ev.optimal,
      avgR: this.rewardCount ? this.rewardSum / this.rewardCount : null });
    compressHistory(this.brain.history, 400);
    this.sinceEval = 0; this.rewardSum = 0; this.rewardCount = 0;
    return ev;
  }
}
function compressHistory(h, max) {
  if (h.length <= max) return;
  const last = h[h.length - 1];
  const kept = h.filter((_, i) => i % 2 === 0);
  if (kept[kept.length - 1] !== last) kept.push(last);
  h.length = 0; h.push(...kept);
}

