function exportBrainFile(b) {
  try {
    const text = stringifyBrainFile(brainToJSON(b));
    const blob = new Blob([text], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `${b.name.replace(/[^\w-]+/g, '_')}-${b.taskId}-brain.json`;
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 2000);
    toast(`Exported ${b.name} (${fmtInt(b.table.size)} positions, ${(text.length / 1024).toFixed(0)} KB)`);
  } catch (e) { showErrors('Export failed', [e.message]); }
}
function copyBrain(b) {
  const text = stringifyBrainFile(brainToJSON(b));
  const fallback = () => {
    const ta = document.createElement('textarea');
    ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
    document.body.appendChild(ta); ta.select();
    let ok = false;
    try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
    ta.remove();
    if (ok) toast(`Copied ${b.name}'s brain JSON to the clipboard.`);
    else { $('#pasteBox').value = text; toast('Clipboard blocked — the JSON was put in the paste box instead; copy it from there.', 4000); }
  };
  if (navigator.clipboard && navigator.clipboard.writeText)
    navigator.clipboard.writeText(text).then(() => toast(`Copied ${b.name}'s brain JSON to the clipboard.`), fallback);
  else fallback();
}
function readFileAndImport(file) {
  if (file.size > 50 * 1024 * 1024) return showErrors('Import failed', [`"${file.name}" is ${(file.size / 1048576).toFixed(0)} MB — too large to be a brain file (limit 50 MB).`]);
  const r = new FileReader();
  r.onload = () => startImport(String(r.result), file.name);
  r.onerror = () => showErrors('Import failed', [`Could not read "${file.name}".`]);
  r.readAsText(file);
}
function startImport(text, source) {
  const res = parseBrainFile(text);
  if (!res.ok) return showErrors(`Could not import ${source}`, res.errors);
  const d = res.data, task = TASKS[d.taskId];
  const targets = App.brains.filter(b => b.taskId === d.taskId).map(b => `<option value="${b.id}">${escapeHtml(b.name)} — ${escapeHtml(b.task.name)}, ${b.isMenace ? 'MENACE' : 'Q'}${b.taskId !== d.taskId ? ' (different task!)' : ''}</option>`).join('');
  showModal(`<h2>Import brain</h2>
    <p><b>${escapeHtml(d.name)}</b> from ${escapeHtml(source)}<br>
    <span class="small muted">${escapeHtml(task.name)} · ${escapeHtml(ALGORITHMS[d.algorithm].name)} · ${fmtInt(d.stateCount)} positions · ${fmtInt(d.stats.gamesPlayed)} games${d.exportedAt ? ' · exported ' + escapeHtml(String(d.exportedAt).slice(0, 10)) : ''}</span></p>
    ${res.warnings.length ? `<ul class="small" style="color:var(--warn)">${res.warnings.map(w => `<li>${escapeHtml(w)}</li>`).join('')}</ul>` : ''}
    <div class="form-grid">
      <label>Into</label><select id="imTarget"><option value="new">➕ A new learning agent</option>${targets}</select>
      <label>Name</label><input type="text" id="imName" value="${escapeHtml(uniqueName(d.name))}" maxlength="40">
      <label class="adv">Mode</label><div class="adv"><label><input type="radio" name="imMode" value="replace" checked> Replace its brain</label><br>
        <label><input type="radio" name="imMode" value="merge"> Merge (average values weighted by visit counts)</label></div>
    </div>
    <ul class="errors" id="imErr"></ul>
    <div class="actions"><button id="imCancel">Cancel</button><button id="imOk" class="primary">Import</button></div>`, box => {
    const sync = () => {
      const isNew = $('#imTarget', box).value === 'new';
      $('#imName', box).disabled = !isNew;
      $$('input[name=imMode]', box).forEach(r => r.disabled = isNew);
      $('#imErr', box).innerHTML = '';
    };
    $('#imTarget', box).onchange = sync; sync();
    $('#imCancel', box).onclick = closeModal;
    $('#imOk', box).onclick = () => {
      const tv = $('#imTarget', box).value, err = $('#imErr', box);
      if (tv === 'new') {
        const b = brainFromData(d, { name: uniqueName($('#imName', box).value.trim() || d.name) });
        App.brains.push(b); closeModal(); markDirty();
        if (b.taskId !== App.env) setEnv(b.taskId);
        refreshPickers(); setActive(b.id); BrainTab.render(); Watch.setup(); if (isWorld()) liveWorld().setup();
        return toast(`Imported ${b.name} with ${fmtInt(b.table.size)} positions.`);
      }
      const target = brainById(tv), mode = $('input[name=imMode]:checked', box).value;
      if (target.taskId !== d.taskId) {
        err.innerHTML = `<li>Wrong task: this brain plays ${escapeHtml(task.name)}, but ${escapeHtml(target.name)} plays ${escapeHtml(target.task.name)}. Import it as a new learning agent instead.</li>`;
        return;
      }
      if (mode === 'merge' && target.algorithm !== d.algorithm) {
        err.innerHTML = `<li>Can't merge a ${escapeHtml(ALGORITHMS[d.algorithm].name)} brain into a ${escapeHtml(ALGORITHMS[target.algorithm].name)} brain — the numbers mean different things. Use Replace or a new learning agent.</li>`;
        return;
      }
      if (Train.trainer && Train.trainer.brain === target) Train.stop();
      if (mode === 'replace') { replaceBrain(target, d); toast(`Replaced ${target.name}'s brain (${fmtInt(target.table.size)} positions).`); }
      else { const n = mergeBrain(target, d); toast(`Merged into ${target.name}: ${fmtInt(n)} values combined, now ${fmtInt(target.table.size)} positions.`); }
      closeModal(); markDirty(); refreshPickers();
      if (target.taskId !== App.env) setEnv(target.taskId);
      if (target.id === App.activeId) { Play.newGame(); Train.render(); } else setActive(target.id);
      if (isWorld()) liveWorld().build();
      BrainTab.render(); Watch.setup();
    };
  });
}

/* ============================================================================
   7. ROOM ENVIRONMENT  (continuous 2-D world, not a grid)
   A blank 10 m x 7 m room (about half a house) with one big box and a floor
   button. Agents are 0.7 m squares; the box is 1.5 m. Agents can move, turn,
   look around, pick things up, put them down, attack/break things and use
   things. Each has health, a 2-slot inventory (the box needs both slots) and a
   memory of where it last saw the box and the button.
   Goal: put the box down on the button. Breaking the box hurts the breaker.
   A round ends on a win or after ROOM.ROUND seconds.

   Interface (what a learning agent uses):
     env.reset()                 start a new round
     env.act(agent, cmd)         start an action, cmd = {type, angle?, dur?} -> {ok, msg}
     env.tick(dt)                advance time; returns events [{type, agent, msg, reward}]
     env.perceive(agent)         update the agent's memory from what it can see
     env.roomKey(agent)          the agent's situation as a short state key (see RoomTask)
     env.observe(agent)          everything the agent knows, as plain data
   Rewards: +1 put the box on the button, -1 broke the box, -0.2 got hit.
   ============================================================================ */
const ROOM = { W: 10, H: 7, AGENT: 0.7, BOX: 1.5, BUTTON: 1.7, REACH: 0.45, SPEED: 1.3, TURN: 4,
  FOV: Math.PI * 0.62, VIEW: 7, BOX_HP: 3, BREAK_HURT: 35, HIT: 12, SLOTS: 2, WIN_PAUSE: 2, RESPAWN: 3, ROUND: 120 };
const angNorm = a => { a = (a + Math.PI) % (2 * Math.PI); if (a < 0) a += 2 * Math.PI; return a - Math.PI; };
/** Overlap area of two axis-aligned squares {x, y, size} (0 if they don't touch). */
function sqOverlap(a, b) {
  const ox = (a.size + b.size) / 2 - Math.abs(a.x - b.x), oy = (a.size + b.size) / 2 - Math.abs(a.y - b.y);
  return ox > 0 && oy > 0 ? ox * oy : 0;
}
/** Distance from a point to the nearest edge of square o (0 if inside). */
function edgeDist(x, y, o) {
  return Math.hypot(Math.max(Math.abs(x - o.x) - o.size / 2, 0), Math.max(Math.abs(y - o.y) - o.size / 2, 0));
}

/* ---------- the Room as a learnable task (so Brain, saving, merging and the explorer all work) ----------
   State key: 5 characters, from the agent's own point of view:
     [0] the box                     0 free (or broken), 1 I'm carrying it, 2 someone else is carrying it
     [1] direction of the target     0 ahead, 1 ahead-right, 2 right, 3 behind-right, 4 behind,
                                     5 behind-left, 6 left, 7 ahead-left, u = doesn't know where it is
         (target = the box, or the button while carrying the box)
     [2] distance to the target      0 right here, 1 close, 2 a few steps, 3 far, x = unknown
     [3] ready?                      1 = can reach the box / the carried box is over the button
     [4] bumped into something on the last move?  0 / 1
   Actions: 0 forward, 1 turn left, 2 turn right, 3 look around, 4 pick up, 5 put down,
            6 attack, 7 use, 8 wait. */
const ROOM_MOVES = ['forward', 'turn left', 'turn right', 'look around', 'pick up', 'put down', 'attack', 'use', 'wait'];
const ROOM_DIRS = ['ahead', 'ahead-right', 'to my right', 'behind me on the right', 'behind me', 'behind me on the left', 'to my left', 'ahead-left'];
const ROOM_SHORT_DIRS = ['ahead', 'ahead-R', 'right', 'back-R', 'behind', 'back-L', 'left', 'ahead-L'];
const ROOM_DIST = ['right here', 'close', 'a few steps away', 'far away'];
function describeRoomKey(k) {
  const hold = k[0] === '1', target = hold ? 'the button' : 'the box';
  let s = hold ? "I'm carrying the box. " : k[0] === '2' ? 'Someone else is carrying the box. ' : '';
  if (k[1] === 'u') s += `I don't know where ${target} is.`;
  else s += `${target[0].toUpperCase() + target.slice(1)} is ${ROOM_DIRS[+k[1]]}, ${ROOM_DIST[+k[2]]}.`;
  if (k[3] === '1') s += hold ? ' The box is right over the button!' : ' I can reach it.';
  if (k[4] === '1') s += ' I just bumped into something.';
  return s;
}
const RoomTask = registerTask({
  id: 'room', name: 'Room', version: 1, kind: 'world', impartial: true, solvable: false,
  numActions: ROOM_MOVES.length, playerNames: ['agent'],
  initialState() { return { key: '0ux00' }; },
  getState(s) { return s.key; },
  currentPlayer() { return 0; },
  legalActions() { return [0, 1, 2, 3, 4, 5, 6, 7, 8]; },
  step(s) { return s; },
  isTerminal() { return false; },
  winner() { return null; },
  reward() { return 0; },
  actionLabel(a) { return ROOM_MOVES[a]; },
  sayMove(a) { return ROOM_MOVES[a]; },
  stateFromKey(k) { return { key: k }; },
  isValidKey(k) { return typeof k === 'string' && /^[012][0-7u][0-3x][01][01]$/.test(k); },
  caption(k) {
    return (k[0] === '1' ? 'carrying · button ' : k[0] === '2' ? 'other carries · box ' : 'box ') + (k[1] === 'u' ? 'unknown' : `${ROOM_SHORT_DIRS[+k[1]]}, ${['here', 'close', 'mid', 'far'][+k[2]]}`) +
      (k[3] === '1' ? ' · ready' : '') + (k[4] === '1' ? ' · bumped' : '');
  },
  /** A 3x3 grid of the 9 actions (heatmap on each), with the situation written above it. */
  render(container, s, opts = {}) {
    const mini = !!opts.mini, ann = opts.annotations || {};
    container.innerHTML = '';
    container.className = 'board roomstate' + (mini ? ' mini' : '');
    if (!mini) { const p = document.createElement('div'); p.className = 'rs-desc'; p.textContent = describeRoomKey(s.key); container.appendChild(p); }
    const grid = document.createElement('div'); grid.className = 'rs-grid';
    for (let a = 0; a < 9; a++) {
      const t = document.createElement('div');
      t.className = 'rs-tile' + (opts.highlight === a ? ' chosen' : '');
      paintAnnotation(t, ann[a], mini);
      if (!mini) t.innerHTML = `<span class="rs-name">${ROOM_MOVES[a]}</span>` + (ann[a] ? `<span class="qv">${ann[a].main}</span>` : '');
      grid.appendChild(t);
    }
    container.appendChild(grid);
  },
});

class RoomEnv {
  constructor(names) {
    this.names = names.slice();
    this.round = 0;
    this.pauseTime = ROOM.WIN_PAUSE;
    this.stats = { wins: 0, broken: 0, winTimes: [], timeouts: 0 };
    this.per = {};
    for (const n of this.names) this.per[n] = { wins: 0, broke: 0, reward: 0, pickups: 0 };
    this.reset();
  }
  reset() {
    this.t = 0; this.done = false; this.winner = null; this.timedOut = false; this.doneTimer = 0; this.round++;
    this.brokeThisRound = false;
    this.events = [];
    this.button = { id: 'button', kind: 'button', name: 'the button', size: ROOM.BUTTON, x: 0, y: 0, pressed: false };
    this.box = { id: 'box', kind: 'box', name: 'the box', size: ROOM.BOX, x: 0, y: 0, hp: ROOM.BOX_HP, heldBy: null,
      broken: false, respawn: 0, slots: 2, lastTouch: null };
    this.agents = [];
    this.placeRandom(this.button, [], 0.3);
    this.placeRandom(this.box, [this.button], 0.4);
    for (const n of this.names) {
      const a = { id: n, kind: 'agent', name: n, size: ROOM.AGENT, x: 0, y: 0, facing: Math.random() * 2 * Math.PI - Math.PI,
        hp: 100, inventory: [], action: null, ko: 0, thought: 'Where am I?', mem: { box: null, button: null },
        bumped: false, acc: 0, prev: null };
      this.placeRandom(a, [this.button, this.box, ...this.agents], 0.3);
      this.agents.push(a);
    }
  }
  placeRandom(obj, avoid, margin) {
    const h = obj.size / 2 + margin;
    for (let k = 0; k < 400; k++) {
      obj.x = h + Math.random() * (ROOM.W - 2 * h);
      obj.y = h + Math.random() * (ROOM.H - 2 * h);
      if (avoid.every(o => Math.abs(o.x - obj.x) > (o.size + obj.size) / 2 + 0.6 || Math.abs(o.y - obj.y) > (o.size + obj.size) / 2 + 0.6)) return;
    }
  }
  get things() { return [this.box, this.button, ...this.agents]; }
  note(a, msg, type = 'info', reward = 0) {
    if (a) a.thought = msg;
    if (a && reward) { this.per[a.name].reward += reward; a.acc += reward; }
    this.events.push({ type, agent: a ? a.name : null, msg, reward, t: this.t });
    return { ok: type !== 'fail', msg };
  }
  heldPos(a, x = a.x, y = a.y, f = a.facing) {
    const d = a.size / 2 + this.box.size / 2 + 0.02;
    return { x: x + Math.cos(f) * d, y: y + Math.sin(f) * d, size: this.box.size };
  }
  insideRoom(o) { const h = o.size / 2; return o.x >= h - 1e-9 && o.y >= h - 1e-9 && o.x <= ROOM.W - h + 1e-9 && o.y <= ROOM.H - h + 1e-9; }
  onButton(o) { return Math.abs(o.x - this.button.x) < ROOM.BUTTON / 2 && Math.abs(o.y - this.button.y) < ROOM.BUTTON / 2; }
  /** Why agent a can't be at (x, y, facing), or null if it can. Only blocks moves that make overlaps worse. */
  blocked(a, x, y, f) {
    const me = { x, y, size: a.size }, was = { x: a.x, y: a.y, size: a.size };
    if (!this.insideRoom(me)) return 'the wall';
    const b = this.box, holding = b.heldBy === a;
    if (!b.broken && !holding && sqOverlap(me, b) > sqOverlap(was, b) + 1e-9) return b.heldBy ? `the box ${b.heldBy.name} is carrying` : 'the box';
    const hp = holding ? this.heldPos(a, x, y, f) : null, hpWas = holding ? this.heldPos(a) : null;
    if (hp && !this.insideRoom(hp)) return 'the wall (the box hit it)';
    for (const o of this.agents) {
      if (o === a) continue;
      if (sqOverlap(me, o) > sqOverlap(was, o) + 1e-9) return o.name;
      if (hp && sqOverlap(hp, o) > sqOverlap(hpWas, o) + 1e-9) return `${o.name} (the box bumped them)`;
    }
    return null;
  }
  setFacing(a, f) {
    if (this.box.heldBy === a && this.blocked(a, a.x, a.y, f)) return false;
    a.facing = angNorm(f);
    return true;
  }
  turnToward(a, target, dt) {
    const diff = angNorm(target - a.facing), step = ROOM.TURN * dt;
    return this.setFacing(a, Math.abs(diff) <= step ? target : a.facing + Math.sign(diff) * step) ? Math.abs(diff) : Infinity;
  }
  /** Things within arm's reach in the front half of the agent. */
  inReach(a, pred) {
    let best = null, bd = Infinity;
    for (const o of this.things) {
      if (o === a || !pred(o)) continue;
      const d = edgeDist(a.x, a.y, o);
      if (d > a.size / 2 + ROOM.REACH) continue;
      const ang = Math.abs(angNorm(Math.atan2(o.y - a.y, o.x - a.x) - a.facing));
      if (ang > Math.PI / 2 && d > a.size / 2 + 0.02) continue;
      if (d < bd) { bd = d; best = o; }
    }
    return best;
  }
  /** What the agent can see: inside its view cone (or all around when allAround). */
  visible(a, allAround = false) {
    const out = [];
    for (const o of this.things) {
      if (o === a || (o === this.box && this.box.broken)) continue;
      const dist = Math.hypot(o.x - a.x, o.y - a.y), ang = angNorm(Math.atan2(o.y - a.y, o.x - a.x) - a.facing);
      if (dist <= ROOM.VIEW && (allAround || Math.abs(ang) <= ROOM.FOV / 2)) out.push({ thing: o, dist, ang });
    }
    return out.sort((p, q) => p.dist - q.dist);
  }
  /** Update the agent's memory of where the box and button are from what it can see right now. */
  perceive(a, allAround = false) {
    const seen = new Set(this.visible(a, allAround).map(v => v.thing));
    if (this.box.heldBy === a) seen.add(this.box);
    for (const k of ['box', 'button']) {
      const o = this[k];
      if (seen.has(o)) { a.mem[k] = { x: o.x, y: o.y }; continue; }
      const m = a.mem[k];     // expected it here, looking right at the spot, and it's gone? forget it
      if (m && Math.hypot(m.x - a.x, m.y - a.y) < 2.5 && Math.abs(angNorm(Math.atan2(m.y - a.y, m.x - a.x) - a.facing)) < ROOM.FOV / 2) a.mem[k] = null;
    }
  }
  roomKey(a) {
    const holding = this.box.heldBy === a, m = holding ? a.mem.button : a.mem.box;
    let dir = 'u', dist = 'x', ready = 0;
    if (holding) ready = this.onButton(this.box) ? 1 : 0;
    else ready = this.inReach(a, x => x === this.box && !this.box.broken && !this.box.heldBy) ? 1 : 0;
    if (m) {
      const rel = angNorm(Math.atan2(m.y - a.y, m.x - a.x) - a.facing);
      dir = String(((Math.round(rel / (Math.PI / 4)) % 8) + 8) % 8);
      const d = holding ? Math.hypot(this.box.x - m.x, this.box.y - m.y) : edgeDist(a.x, a.y, { x: m.x, y: m.y, size: ROOM.BOX });
      dist = String(holding ? (d < ROOM.BUTTON / 2 ? 0 : d < 2 ? 1 : d < 4.5 ? 2 : 3) : (d <= a.size / 2 + ROOM.REACH ? 0 : d < 2 ? 1 : d < 4.5 ? 2 : 3));
    }
    return `${holding ? 1 : this.box.heldBy ? 2 : 0}${dir}${dist}${ready}${a.bumped ? 1 : 0}`;
  }
  /** "Warmer/colder" hint used for reward shaping: 0..1, higher = closer to done. */
  potential(a) {
    const b = this.box, D = Math.hypot(ROOM.W, ROOM.H);
    if (b.broken) return 0;
    if (b.heldBy === a) return 0.5 + 0.5 * (1 - Math.hypot(b.x - this.button.x, b.y - this.button.y) / D);
    return 0.5 * (1 - edgeDist(a.x, a.y, b) / D);
  }
  slotsUsed(a) { return a.inventory.reduce((s, i) => s + i.slots, 0); }

  act(a, cmd) {
    if (this.done) return { ok: false, msg: 'The round is over.' };
    if (a.ko > 0) return { ok: false, msg: 'Knocked out...' };
    const b = this.box, holding = b.heldBy === a;
    switch (cmd.type) {
      case 'move':
        a.action = { type: 'move', angle: cmd.angle == null ? a.facing : cmd.angle, t: cmd.dur == null ? 1 : cmd.dur, quiet: cmd.quiet, snap: cmd.snap };
        a.bumped = false;
        if (!cmd.quiet) a.thought = holding ? 'Carrying the box over here...' : pickOne(["Let's go this way.", 'Walking around...', 'Just wandering.']);
        return { ok: true };
      case 'turn':
        a.action = { type: 'turn', angle: cmd.angle == null ? a.facing + Math.PI / 2 : cmd.angle, t: 1.5 };
        a.thought = 'Turning around.';
        return { ok: true };
      case 'look':
        a.action = { type: 'look', t: 1.6 };
        a.thought = 'Let me look around...';
        return { ok: true };
      case 'wait':
        a.action = { type: 'wait', t: cmd.dur == null ? 0.8 : cmd.dur };
        a.thought = 'Just standing here.';
        return { ok: true };
      case 'pickup': {
        a.action = { type: 'busy', t: 0.3 };
        const o = this.inReach(a, x => x === b && !b.broken && !b.heldBy);
        if (!o) return this.note(a, holding ? "I'm already holding the box." : "There's nothing here I can pick up.", 'fail');
        if (this.slotsUsed(a) + b.slots > ROOM.SLOTS) return this.note(a, 'My hands are full.', 'fail');
        const p = this.heldPos(a);
        if (!this.insideRoom(p) || this.agents.some(o2 => o2 !== a && sqOverlap(p, o2) > 0))
          return this.note(a, "There's no room to lift the box from here.", 'fail');
        b.heldBy = a; a.inventory.push(b); b.x = p.x; b.y = p.y;
        this.per[a.name].pickups++;
        return this.note(a, "I picked up the box! It's big, I need both hands.", 'pickup');
      }
      case 'putdown': {
        a.action = { type: 'busy', t: 0.3 };
        if (!a.inventory.length) return this.note(a, "I'm not holding anything.", 'fail');
        const item = a.inventory.pop();
        item.heldBy = null; item.lastTouch = a;
        return this.note(a, this.onButton(item) ? 'I put the box down on the button...' : 'I put the box down.', 'putdown');
      }
      case 'attack': {
        a.action = { type: 'attack', t: 0.45 };
        if (holding) return this.note(a, "I can't swing while I'm carrying the box.", 'fail');
        const o = this.inReach(a, x => (x === b && !b.broken && !b.heldBy) || (x.kind === 'agent' && x.ko <= 0));
        if (!o) return this.note(a, 'I swung at the air.', 'fail');
        if (o === b) {
          b.hp--;
          if (b.hp > 0) return this.note(a, `I hit the box! It's cracking (${b.hp}/${ROOM.BOX_HP} left).`, 'hit');
          b.broken = true; b.respawn = ROOM.RESPAWN; b.lastTouch = null;
          a.hp -= ROOM.BREAK_HURT;
          this.stats.broken++; this.per[a.name].broke++; this.brokeThisRound = true;
          const r = this.note(a, `Ouch! I broke the box and a splinter hurt me (-${ROOM.BREAK_HURT} health).`, 'break', -1);
          if (a.hp <= 0) this.knockOut(a);
          return r;
        }
        o.hp -= ROOM.HIT;
        const push = this.heldPos(a);
        if (!this.blocked(o, o.x + (push.x - a.x) * 0.3, o.y + (push.y - a.y) * 0.3, o.facing)) { o.x += (push.x - a.x) * 0.3; o.y += (push.y - a.y) * 0.3; }
        this.note(o, `Hey! ${a.name} hit me.`, 'hurt', -0.2);
        if (o.hp <= 0) this.knockOut(o);
        return this.note(a, `I hit ${o.name}.`, 'hit');
      }
      case 'use': {
        a.action = { type: 'busy', t: 0.3 };
        if (holding) return this.note(a, "It's a box. I can't really use it, but maybe I could put it somewhere.", 'use');
        const o = this.inReach(a, () => true);
        if (!o) return this.note(a, "There's nothing to use here.", 'fail');
        if (o === this.button) return this.note(a, 'I pressed the button with my hand... nothing happened. Maybe it needs something heavy on it.', 'use');
        if (o === b) return this.note(a, "It's a box. I can't really use it... maybe I could carry it.", 'use');
        return this.note(a, `I poked ${o.name}. They didn't like that.`, 'use');
      }
      default:
        return { ok: false, msg: 'Unknown action ' + cmd.type };
    }
  }
  knockOut(a) {
    a.hp = 0; a.ko = 4; a.action = null;
    for (const i of a.inventory) i.heldBy = null;
    a.inventory = [];
    this.note(a, 'I got knocked out...', 'ko');
  }
  finishLook(a) {
    this.perceive(a, true);
    const seen = this.visible(a, true);
    const say = seen.map(v => v.thing.kind === 'agent' ? v.thing.name : `${v.thing.name} (${v.dist.toFixed(1)} m away)`);
    this.note(a, seen.length ? `I can see ${say.length > 1 ? say.slice(0, -1).join(', ') + ' and ' + say[say.length - 1] : say[0]}.` : 'Nothing but walls.', 'look');
  }
  tick(dt) {
    this.events = [];
    this.t += dt;
    if (this.done) {
      this.doneTimer -= dt;
      if (this.doneTimer <= 0) { this.reset(); this.note(null, `Round ${this.round} starts.`, 'round'); }
      return this.events;
    }
    const b = this.box;
    if (b.broken) {
      b.respawn -= dt;
      if (b.respawn <= 0) {
        b.broken = false; b.hp = ROOM.BOX_HP;
        this.placeRandom(b, [this.button, ...this.agents], 0.4);
