<script>
"use strict";
/* ============================================================================
   0. UTILITIES
   ============================================================================ */
const FORMAT_NAME = 'glassbox-brain';
const FORMAT_VERSION = 1;
const APP_NAME = 'Glass Box';
const LS_KEY = 'glassbox-ai/v1';

const clamp = (x, lo, hi) => Math.max(lo, Math.min(hi, x));
const randInt = n => (Math.random() * n) | 0;
const randChoice = arr => arr[randInt(arr.length)];
const round4 = x => Math.round(x * 10000) / 10000;
const fmtQ = q => (q < 0 ? '−' : '+') + Math.abs(q).toFixed(2);
const fmtPct = x => (x == null ? '—' : (x * 100).toFixed(x > 0 && x < 0.1 ? 1 : 0) + '%');
const fmtInt = n => Math.round(n).toLocaleString('en-US');
const uid = () => Math.random().toString(36).slice(2, 10) + Date.now().toString(36).slice(-4);
function fnv1a(str) {
  let h = 0x811c9dc5;
  for (let i = 0; i < str.length; i++) { h ^= str.charCodeAt(i); h = Math.imul(h, 0x01000193); }
  return (h >>> 0).toString(16).padStart(8, '0');
}
function escapeHtml(s) {
  return String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}
/** Game-theoretic outcome class of a (possibly discounted) value: 1 win, 0 draw, -1 loss. */
const outcomeOf = v => (v > 1e-9 ? 1 : v < -1e-9 ? -1 : 0);

/* ============================================================================
   1. TASK INTERFACE
   ----------------------------------------------------------------------------
   A Task is a plain object describing a 2-player, turn-based, deterministic game.
   States are treated as immutable values.

   Required fields
     id            unique string (goes into brain files)
     name          display name
     version       integer, bump when rules or state encoding change
     numActions    actions are integers 0..numActions-1
     playerNames   e.g. ['X','O']
   Required methods
     initialState()            -> state
     getState(s)               -> string key: everything that matters from the
                                  point of view of the player to move (Q-table key)
     currentPlayer(s)          -> 0 | 1
     legalActions(s)           -> array of action ints ([] when terminal)
     step(s, a)                -> new state (never mutates s)
     isTerminal(s)             -> boolean
     winner(s)                 -> 0 | 1 | -1 (draw) | null (not finished)
     reward(s, player)         -> +1 / 0 / -1 for `player` at a terminal state, 0 otherwise
     actionLabel(a)            -> human text, e.g. "corner (0,0)"
     stateFromKey(key)         -> a state object for a key (used by explorer/import)
     isValidKey(key)           -> boolean (import validation)
     render(container, s, opts)-> draws the board into a DOM element. opts:
         annotations {action: {color, main, sub, title}}  heatmap per action
         highlight   action to outline (the chosen move)
         lastAction  action to mark as last played
         onAction    click handler (a) => ..., omit for read-only boards
         mini        tiny board for the brain explorer
   Optional
     sayMove(a)    move in everyday words, e.g. "the top-left corner" (simple mode)
     tactics(s, a, o) -> array of first-person sentences about what move a does
                   ("You have two in a row, so I shouldn't let you get three").
                   o = {subj, Subj, obj, has, s} words for the opponent.
     hint          text shown under the board
     solvable      false if the game tree is too big for the built-in perfect solver
   ============================================================================ */
const TASKS = Object.create(null);
const TASK_METHODS = ['initialState', 'getState', 'currentPlayer', 'legalActions', 'step', 'isTerminal',
  'winner', 'reward', 'actionLabel', 'stateFromKey', 'isValidKey', 'render'];
function registerTask(task) {
  for (const f of ['id', 'name', 'version', 'numActions', 'playerNames'])
    if (task[f] == null) throw new Error(`Task is missing field "${f}"`);
  for (const m of TASK_METHODS)
    if (typeof task[m] !== 'function') throw new Error(`Task "${task.id}" is missing method ${m}()`);
  TASKS[task.id] = task;
  return task;
}
/** Shared helper for task renderers: paint one heatmap annotation onto a DOM node. */
function paintAnnotation(node, ann, mini) {
  if (!ann) return;
  node.classList.add('annotated');
  node.style.setProperty('--heat', ann.color);
  if (ann.title) node.title = ann.title;
  if (!mini) node.innerHTML = `<span class="qv">${ann.main}</span>${ann.sub ? `<span class="qn">${ann.sub}</span>` : ''}`;
}

/* ============================================================================
   2. TASKS
   To add a game: copy one of these objects, implement the interface above,
   and call registerTask(). It then shows up in "New learning agent" automatically.
   ============================================================================ */

/* ---------- Tic-Tac-Toe ---------- */
const TTT_SAY = ['the top-left corner', 'the top-middle square', 'the top-right corner', 'the middle-left square', 'the middle',
  'the middle-right square', 'the bottom-left corner', 'the bottom-middle square', 'the bottom-right corner'];
const TTT_LINES = [[0, 1, 2], [3, 4, 5], [6, 7, 8], [0, 3, 6], [1, 4, 7], [2, 5, 8], [0, 4, 8], [2, 4, 6]];
function tttResult(b) {
  for (const [x, y, z] of TTT_LINES)
    if (b[x] !== '-' && b[x] === b[y] && b[y] === b[z]) return { w: b[x] === 'X' ? 0 : 1, line: [x, y, z] };
  if (b.indexOf('-') === -1) return { w: -1, line: null };
  return null;
}
const TicTacToe = registerTask({
  id: 'tictactoe', name: 'Tic-Tac-Toe', version: 1, numActions: 9, playerNames: ['X', 'O'],
  hint: 'Three in a row wins. Numbers on empty squares are the agent\'s learned values for that move.',
  initialState() { return { b: '---------', p: 0, result: null }; },
  getState(s) { return s.b; },
  currentPlayer(s) { return s.p; },
  legalActions(s) {
    if (s.result) return [];
    const r = [];
    for (let i = 0; i < 9; i++) if (s.b[i] === '-') r.push(i);
    return r;
  },
  step(s, a) {
    if (s.result || s.b[a] !== '-') throw new Error('Illegal move ' + a);
    const b = s.b.slice(0, a) + (s.p === 0 ? 'X' : 'O') + s.b.slice(a + 1);
    return { b, p: 1 - s.p, result: tttResult(b) };
  },
  isTerminal(s) { return !!s.result; },
  winner(s) { return s.result ? s.result.w : null; },
  reward(s, player) {
    if (!s.result || s.result.w === -1) return 0;
    return s.result.w === player ? 1 : -1;
  },
  actionLabel(a) {
    const r = (a / 3) | 0, c = a % 3;
    const kind = a === 4 ? 'center' : (r !== 1 && c !== 1) ? 'corner' : 'edge';
    return `${kind} (${r},${c})`;
  },
  sayMove(a) { return TTT_SAY[a]; },
  /** Plain-English observations about playing `a` in `s` (used for the agent's inner monologue). o = opponent words. */
  tactics(s, a, o) {
    const me = s.p === 0 ? 'X' : 'O', them = me === 'X' ? 'O' : 'X';
    const wins = (b, m) => {
      const r = [];
      for (let i = 0; i < 9; i++) if (b[i] === '-') {
        const res = tttResult(b.slice(0, i) + m + b.slice(i + 1));
        if (res && res.w === (m === 'X' ? 0 : 1)) r.push(i);
      }
      return r;
    };
    const myWins = wins(s.b, me), theirWins = wins(s.b, them), L = TTT_SAY[a], out = [];
    if (myWins.includes(a)) return [`Wait, I have two in a row! If I take ${L} I get three. I win!`];
    const pieces = 9 - (s.b.match(/-/g) || []).length;
    if (pieces === 0) out.push(a === 4 ? `The middle is part of four lines, so it's a strong way to start.` : a % 2 === 0 ? `Corners are part of three lines, so a corner is a good start.` : `An edge is only part of two lines... an odd start, but let's see what happens.`);
    else if (pieces === 1 && s.b[4] !== '-' && a % 2 === 0) out.push(`${o.Subj} took the middle, so I'll grab a corner.`);
    else if (pieces === 1 && a === 4) out.push(`The middle is still free, I'll take it.`);
    if (theirWins.length) {
      if (theirWins.includes(a)) out.push(theirWins.length > 1 ? `Uh oh, ${o.subj} ${o.has} two ways to win. I can only block one of them...` : `${o.Subj} ${o.has} two in a row, so I shouldn't let ${o.obj} get three. Blocking ${L}!`);
      else out.push(`${o.Subj} could get three in a row at ${TTT_SAY[theirWins[0]]}... and I'm not blocking it. That might be a big mistake.`);
    }
    if (myWins.length) out.push(`(Hold on, I could have won at ${TTT_SAY[myWins[0]]}. I haven't learned to spot that yet.)`);
    const threats = wins(s.b.slice(0, a) + me + s.b.slice(a + 1), me).length;
    if (threats >= 2) out.push(`And now I have two ways to win. ${o.Subj} can only stop one!`);
    else if (threats === 1 && !theirWins.some(x => x !== a)) out.push(`That makes two in a row, so ${o.subj} will have to block me.`);
    return out;
  },
  stateFromKey(k) {
    let x = 0, o = 0;
    for (const ch of k) { if (ch === 'X') x++; else if (ch === 'O') o++; }
    return { b: k, p: x === o ? 0 : 1, result: tttResult(k) };
  },
  isValidKey(k) {
    if (typeof k !== 'string' || !/^[XO-]{9}$/.test(k)) return false;
    let x = 0, o = 0;
    for (const ch of k) { if (ch === 'X') x++; else if (ch === 'O') o++; }
    return x === o || x === o + 1;
  },
  render(container, s, opts = {}) {
    const mini = !!opts.mini, ann = opts.annotations || {};
    container.innerHTML = '';
    container.className = 'board ttt' + (mini ? ' mini' : '');
    const win = (s.result && s.result.line) || [];
    for (let i = 0; i < 9; i++) {
      const cell = document.createElement(mini ? 'div' : 'button');
      cell.className = 'cell';
      const ch = s.b[i];
      if (ch !== '-') { cell.textContent = ch; cell.classList.add(ch === 'X' ? 'x' : 'o'); }
      else paintAnnotation(cell, ann[i], mini);
      if (win.includes(i)) cell.classList.add('win');
      if (opts.highlight === i) cell.classList.add('chosen');
      if (opts.lastAction === i) cell.classList.add('last');
      if (!mini) {
        if (opts.onAction && ch === '-' && !s.result) cell.addEventListener('click', () => opts.onAction(i));
        else cell.classList.add('locked');
        cell.setAttribute('aria-label', this.actionLabel(i) + (ch !== '-' ? ' ' + ch : ''));
      }
      container.appendChild(cell);
    }
  },
});

/* ---------- Nim (second task, proves the interface is generic) ---------- */
const NIM_START = [1, 3, 5, 7], NIM_MAX = 7;
const Nim = registerTask({
  id: 'nim', name: 'Nim (1-3-5-7)', version: 1, impartial: true, numActions: NIM_START.length * NIM_MAX, playerNames: ['P1', 'P2'],
  hint: 'Click a stick to take it and every stick to its right. Whoever takes the last stick wins.',
  initialState() { return { h: NIM_START.slice(), p: 0, over: false, w: null }; },
  getState(s) { return s.h.join(''); },
  currentPlayer(s) { return s.p; },
  legalActions(s) {
    const r = [];
    for (let i = 0; i < s.h.length; i++) for (let k = 1; k <= s.h[i]; k++) r.push(i * NIM_MAX + k - 1);
    return r;
  },
  step(s, a) {
    const i = (a / NIM_MAX) | 0, take = (a % NIM_MAX) + 1;
    if (s.over || i >= s.h.length || take > s.h[i]) throw new Error('Illegal move ' + a);
    const h = s.h.slice(); h[i] -= take;
    const over = h.every(x => x === 0);
    return { h, p: 1 - s.p, over, w: over ? s.p : null };   // normal play: last taker wins
  },
  isTerminal(s) { return s.over; },
  winner(s) { return s.over ? s.w : null; },
  reward(s, player) { return s.over ? (s.w === player ? 1 : -1) : 0; },
  actionLabel(a) { return `take ${(a % NIM_MAX) + 1} from pile ${((a / NIM_MAX) | 0) + 1}`; },
  sayMove(a) { const k = (a % NIM_MAX) + 1; return `${k} stick${k > 1 ? 's' : ''} from pile ${((a / NIM_MAX) | 0) + 1}`; },
  tactics(s, a, o) {
    const i = (a / NIM_MAX) | 0, h = s.h.slice(); h[i] -= (a % NIM_MAX) + 1;
    const xor = arr => arr.reduce((x, y) => x ^ y, 0);
    if (h.every(x => x === 0)) return [`Only one pile left, so I'll take ${this.sayMove(a)} and win!`];
    const out = [];
    if (s.h.filter(x => x > 0).length === 1) out.push(`(Hmm, I could have taken the whole last pile and won...)`);
    if (h.filter(x => x > 0).length === 1) out.push(`Oops, that leaves just one pile. ${o.Subj} can take it all and win.`);
    else if (xor(s.h) === 0) out.push(`Every move here feels risky. I'll just hope ${o.subj} slip${o.s} up.`);
    else if (xor(h) === 0) out.push(`I like this: it leaves the piles "balanced", so whatever ${o.subj} take${o.s}, I should be able to answer it.`);
    return out;
  },
  stateFromKey(k) {
    const h = k.split('').map(Number), over = h.every(x => x === 0);
    return { h, p: 0, over, w: over ? 1 : null };   // Nim is impartial: the mover's identity doesn't matter
  },
  isValidKey(k) {
    return typeof k === 'string' && /^[0-9]{4}$/.test(k) && k.split('').every((c, i) => +c <= NIM_START[i]);
  },
  render(container, s, opts = {}) {
    const mini = !!opts.mini, ann = opts.annotations || {}, hl = opts.highlight;
    container.innerHTML = '';
    container.className = 'board nim' + (mini ? ' mini' : '');
    for (let i = 0; i < NIM_START.length; i++) {
      const row = document.createElement('div');
      row.className = 'nim-row';
      if (!mini) { const lab = document.createElement('span'); lab.className = 'nim-label'; lab.textContent = `Pile ${i + 1}`; row.appendChild(lab); }
      const h = s.h[i];
      const hlTake = hl != null && ((hl / NIM_MAX) | 0) === i ? (hl % NIM_MAX) + 1 : 0;
      for (let j = 0; j < NIM_START[i]; j++) {
        const stick = document.createElement(mini ? 'div' : 'button');
        stick.className = 'stick';
        if (j >= h) { stick.classList.add('gone', 'locked'); row.appendChild(stick); continue; }
        const take = h - j, a = i * NIM_MAX + take - 1;
        paintAnnotation(stick, ann[a], mini);
        if (hlTake && j >= h - hlTake) stick.classList.add(j === h - hlTake ? 'chosen' : 'taking');
        if (!mini) {
          stick.title = (stick.title ? stick.title + '\n' : '') + `Take ${take} from pile ${i + 1}`;
          if (opts.onAction && !s.over) stick.addEventListener('click', () => opts.onAction(a));
          else stick.classList.add('locked');
        }
        row.appendChild(stick);
      }
      container.appendChild(row);
    }
  },
});

/* ---------- Perfect solver (generic negamax, used as opponent & benchmark) ---------- */
const Solver = {
  memo: new Map(),
  /** Value for the player to move; wins found sooner are worth slightly more (0.99 per ply). */
  value(task, s) {
    if (task.isTerminal(s)) return task.reward(s, task.currentPlayer(s));
    let m = this.memo.get(task.id);
    if (!m) { m = new Map(); this.memo.set(task.id, m); }
    const key = task.getState(s);
    let v = m.get(key);
    if (v !== undefined) return v;
    v = -Infinity;
    for (const a of task.legalActions(s)) v = Math.max(v, -0.99 * this.value(task, task.step(s, a)));
    m.set(key, v);
    return v;
  },
  actionValues(task, s) {
    return task.legalActions(s).map(a => ({ a, v: -0.99 * this.value(task, task.step(s, a)) }));
  },
  pick(av) {
    const best = Math.max(...av.map(x => x.v));
    return randChoice(av.filter(x => x.v >= best - 1e-9)).a;
  },
  /** true if action a keeps the best achievable game-theoretic outcome (win/draw/loss). */
  isOptimal(task, s, a) {
    const av = this.actionValues(task, s);
    const best = Math.max(...av.map(x => outcomeOf(x.v)));
    return outcomeOf(av.find(x => x.a === a).v) === best;
  },
};

/* ============================================================================
   3. AGENT / BRAIN
   Brain = Q-table (Map stateKey -> {q: Float64Array, n: Uint32Array}) + metadata.
   Values are from the perspective of the player to move, so one table can play
   either side and learn from self-play.
   ============================================================================ */
const ALGORITHMS = {
  qlearning: { name: 'Q-learning (ε-greedy)' },
  menace: { name: 'MENACE (matchbox beads)' },
};
const DEFAULT_HYPER = {
  alpha: 0.3, gamma: 0.9, epsilon: 0.3, epsilonDecay: 0.9998, epsilonMin: 0.02, initialQ: 0,
  initialBeads: 4, winBeads: 3, drawBeads: 1, lossBeads: -1,
};
const HYPER_LIMITS = {
  alpha: [0.001, 1], gamma: [0, 1], epsilon: [0, 1], epsilonDecay: [0.9, 1], epsilonMin: [0, 1], initialQ: [-1, 1],
  initialBeads: [1, 100], winBeads: [-100, 100], drawBeads: [-100, 100], lossBeads: [-100, 100],
};
const TEACH_RATE = 0.5;  // how far a "good/bad move" click pushes Q toward +1/-1

function argmaxRandom(e, legal, def) {
  let best = -Infinity, pick = legal[0], cnt = 0;
  for (const x of legal) {
    const v = e ? e.q[x] : def;
    if (v > best + 1e-12) { best = v; pick = x; cnt = 1; }
    else if (v >= best - 1e-12 && Math.random() * ++cnt < 1) pick = x;
  }
  return pick;
}

class Brain {
  constructor(o = {}) {
    if (!TASKS[o.taskId]) throw new Error('Unknown task ' + o.taskId);
    this.id = o.id || uid();
    this.name = o.name || 'Unnamed';
    this.taskId = o.taskId;
    this.algorithm = ALGORITHMS[o.algorithm] ? o.algorithm : 'qlearning';
    this.hyper = Object.assign({}, DEFAULT_HYPER, o.hyper || {});
    const now = new Date().toISOString();
    this.stats = Object.assign({ gamesPlayed: 0, wins: 0, losses: 0, draws: 0, selfPlayGames: 0, taughtMoves: 0, created: now, updated: now }, o.stats || {});
    this.revision = o.revision || 0;
    this.history = Array.isArray(o.history) ? o.history : [];
    this.table = new Map();
    this.bench = null;
  }
  get task() { return TASKS[this.taskId]; }
  get isMenace() { return this.algorithm === 'menace'; }
  get defaultValue() { return this.isMenace ? this.hyper.initialBeads : this.hyper.initialQ; }

  /** Get (creating if needed) the table entry for a state. */
  entry(key, state) {
    let e = this.table.get(key);
    if (!e) {
      const n = this.task.numActions;
      e = { q: new Float64Array(n), n: new Uint32Array(n) };
      const def = this.defaultValue;
      if (def !== 0) for (const a of this.task.legalActions(state)) e.q[a] = def;
      this.table.set(key, e);
    }
    return e;
  }
  /** Read-only view of what the brain knows about a state. */
  evaluate(state) {
    const task = this.task, key = task.getState(state), legal = task.legalActions(state);
    const e = this.table.get(key), def = this.defaultValue;
    let visits = 0;
    const items = legal.map(a => {
      const v = e ? e.n[a] : 0; visits += v;
      return { a, value: e ? e.q[a] : def, visits: v };
    });
    return { key, legal, items, visits, known: !!e };
  }
  maxQ(state) {
    const task = this.task;
    if (task.isTerminal(state)) return 0;
    const e = this.table.get(task.getState(state)), def = this.defaultValue;
    let m = -Infinity;
    for (const a of task.legalActions(state)) m = Math.max(m, e ? e.q[a] : def);
    return m;
  }
  /** Pick an action. verbose=true returns a full, explainable decision record. */
  choose(state, { explore = true, verbose = false } = {}) {
    const task = this.task, key = task.getState(state), legal = task.legalActions(state);
    const e = this.table.get(key), def = this.defaultValue;
    let a, kind;
    if (legal.length === 1) { a = legal[0]; kind = 'forced'; }
    else if (this.isMenace) {
      if (explore) {
        let total = 0;
        for (const x of legal) total += Math.max(0, e ? e.q[x] : def);
        if (total <= 0) a = randChoice(legal);
        else {
          let r = Math.random() * total; a = legal[legal.length - 1];
          for (const x of legal) { r -= Math.max(0, e ? e.q[x] : def); if (r < 0) { a = x; break; } }
        }
        kind = 'sample';
      } else { a = argmaxRandom(e, legal, def); kind = 'exploit'; }
    } else {
      const eps = explore ? this.hyper.epsilon : 0;
      if (eps > 0 && Math.random() < eps) { a = randChoice(legal); kind = 'explore'; }
      else { a = argmaxRandom(e, legal, def); kind = 'exploit'; }
    }
    if (!verbose) return { a, key, kind };
    return this.describe(state, a, kind, explore);
  }
  describe(state, a, kind, explore) {
    const ev = this.evaluate(state);
    const sorted = ev.items.slice().sort((x, y) => y.value - x.value);
    const best = sorted[0].value, second = sorted.length > 1 ? sorted[1].value : null;
    const bestCount = sorted.filter(i => Math.abs(i.value - best) < 1e-9).length;
    const chosen = ev.items.find(i => i.a === a);
    let confidence = 1;
    if (ev.legal.length > 1) {
      const experience = 1 - Math.exp(-ev.visits / 12);
      let clarity;
      if (this.isMenace) {
        const total = sorted.reduce((s, i) => s + Math.max(0, i.value), 0);
        const share = total > 0 ? best / total : 0, uniform = 1 / ev.legal.length;
        clarity = clamp((share - uniform) / (1 - uniform), 0, 1);
      } else clarity = clamp((best - second) / 0.5, 0, 1);
      confidence = experience * (0.35 + 0.65 * clarity);
    }
    const d = {
      a, key: ev.key, kind, state, legal: ev.legal, items: ev.items, sorted, best, second, bestCount, chosen,
      visits: ev.visits, known: ev.known, eps: explore ? this.hyper.epsilon : 0, confidence,
      algo: this.algorithm, playerName: this.name,
    };
    d.text = explainDecision(this.task, d, this.defaultValue);
    return d;
  }
  /** Q-learning update: Q(s,a) += alpha * (target - Q(s,a)). */
  tdUpdate(key, state, a, target) {
    const e = this.entry(key, state), before = e.q[a];
    const after = before + this.hyper.alpha * (target - before);
    e.q[a] = after;
    if (e.n[a] < 0xffffffff) e.n[a]++;
    return { a, before, after, target };
  }
  /** MENACE: add/remove beads on every move of the game. */
  menaceUpdate(traj, reward) {
    const h = this.hyper, delta = reward > 0 ? h.winBeads : reward < 0 ? h.lossBeads : h.drawBeads;
    const ups = [];
    for (const t of traj) {
      const e = this.entry(t.key, t.state), before = e.q[t.a];
      e.q[t.a] = Math.max(0, before + delta);
      if (e.n[t.a] < 0xffffffff) e.n[t.a]++;
      let refilled = false;
      const legal = this.task.legalActions(t.state);
      if (legal.every(x => e.q[x] <= 0)) { for (const x of legal) e.q[x] = 1; refilled = true; }
      ups.push({ a: t.a, mi: t.mi, before, after: e.q[t.a], delta, refilled });
    }
    return ups;
  }
  /** Human feedback: nudge one move's value. */
  teach(state, a, good) {
    const e = this.entry(this.task.getState(state), state), before = e.q[a];
    if (this.isMenace) e.q[a] = Math.max(0, before + (good ? this.hyper.winBeads : this.hyper.lossBeads * 2 || -2));
    else e.q[a] = before + TEACH_RATE * ((good ? 1 : -1) - before);
    this.stats.taughtMoves++;
    this.revision++;
    return { a, before, after: e.q[a] };
  }
  reset() {
    this.table.clear();
    const now = new Date().toISOString();
    this.stats = { gamesPlayed: 0, wins: 0, losses: 0, draws: 0, selfPlayGames: 0, taughtMoves: 0, created: now, updated: now };
    this.history = []; this.revision = 0; this.bench = null;
    this.hyper.epsilon = DEFAULT_HYPER.epsilon;
  }
}

function explainDecision(task, d, def) {
  const L = a => task.actionLabel(a);
  const n = d.legal.length, c = d.chosen;
  if (d.kind === 'forced') return `Forced: ${L(d.a)} is the only legal move.`;
  const outlook = v => v > 0.7 ? ' I expect to win from here.' : v < -0.6 ? ' Every option looks bad — I expect to lose.' : Math.abs(v) < 0.15 && d.visits > 20 ? ' Looks like a draw with good play.' : '';
  const seen = d.visits ? ` Seen this position ${fmtInt(d.visits)} time${d.visits === 1 ? '' : 's'}.` : '';
  if (d.algo === 'menace') {
    const total = d.items.reduce((s, i) => s + Math.max(0, i.value), 0);
    const beads = Math.round(c.value);
    const top = d.sorted[0];
    return `Drew a bead from the matchbox: ${L(d.a)} had ${beads} of ${Math.round(total)} beads (${fmtPct(total ? c.value / total : 1 / n)} chance). ` +
      (d.bestCount === n ? 'All moves have the same number of beads.' : Math.abs(c.value - top.value) < 1e-9 ? 'That is the most-favoured move.' : `Most beads are on ${L(top.a)} (${Math.round(top.value)}).`) +
      (d.visits ? ` This box has been used ${fmtInt(d.visits)} times.` : ' Brand-new box — all moves equally likely.');
  }
  if (d.kind === 'explore') {
    const top = d.sorted[0];
    return `Explored: picked a random move — ${L(d.a)} (ε = ${fmtPct(d.eps)}). Its value is ${fmtQ(c.value)}; ` +
      (Math.abs(c.value - top.value) < 1e-9 ? 'by luck that is also my top choice.' : `my best known option was ${L(top.a)} at ${fmtQ(top.value)}.`) +
      ' Exploring is how I find out whether my estimates are wrong.' + seen;
  }
  if (!d.known) return `New position — I have never seen this before. All ${n} options are valued ${fmtQ(def)}, so I picked ${L(d.a)} at random.`;
  if (d.bestCount > 1) return `Exploited: ${d.bestCount} moves tie at ${fmtQ(d.best)} — picked ${L(d.a)} at random among them.${seen}${outlook(d.best)}`;
  const nb = d.sorted[1];
  return `Exploited: ${L(d.a)} has value ${fmtQ(c.value)}, highest of ${n} options (next best: ${L(nb.a)} at ${fmtQ(nb.value)}).${seen}${outlook(c.value)}`;
}

function describeUpdate(task, u) {
  const L = task.actionLabel(u.a);
  if (u.why === 'bootstrap')
    return `Updated ${L}: ${fmtQ(u.before)} → ${fmtQ(u.after)} (target ${fmtQ(u.target)} = γ ${u.gamma} × best value of the next position ${fmtQ(u.nextBest)})`;
  if (u.why === 'terminal')
    return `Game over → ${u.reward > 0 ? 'WIN (+1)' : u.reward < 0 ? 'LOSS (−1)' : 'DRAW (0)'}: ${L} ${fmtQ(u.before)} → ${fmtQ(u.after)} (moved ${fmtPct(u.alpha)} of the way to ${fmtQ(u.target)})`;
  if (u.why === 'beads')
    return `${L}: ${Math.round(u.before)} → ${Math.round(u.after)} beads (${u.delta >= 0 ? '+' : ''}${u.delta})${u.refilled ? ' — box ran empty and was refilled' : ''}`;
  if (u.why === 'teach')
    return `You taught: ${L} is ${u.good ? 'GOOD' : 'BAD'} → ${u.menace ? Math.round(u.before) + ' → ' + Math.round(u.after) + ' beads' : fmtQ(u.before) + ' → ' + fmtQ(u.after)}`;
  return '';
}

/* ============================================================================
   4. GAME SESSION + TRAINER
   A player is {kind:'brain', brain, learn, explore} | {kind:'random'} |
   {kind:'perfect'} | {kind:'human'}.
   Learning uses the player's own trajectory: Q(s,a) of a player's move is updated
   when that same player is to move again (target = γ·max Q(next)), or at the end
   of the game (target = reward). So self-play, vs-random and vs-human all work.
   ============================================================================ */
function playerLabel(p) {
  return p.kind === 'brain' ? p.brain.name : p.kind === 'random' ? 'Random' : p.kind === 'perfect' ? 'Perfect solver' : 'You';
}

class GameSession {
  constructor(task, players, opts = {}) {
    this.task = task; this.players = players;
    this.record = !!opts.record; this.observer = opts.observer || null;
    this.state = task.initialState();
    this.pending = [null, null]; this.traj = [[], []];
    this.moves = []; this.over = false; this.winner = null; this.lastUpdates = [];
  }
  get current() { return this.task.currentPlayer(this.state); }
  get currentPlayer() { return this.players[this.current]; }
  decide(verbose = false) {
    const p = this.currentPlayer, s = this.state, task = this.task;
    if (p.kind === 'brain') return p.brain.choose(s, { explore: p.explore !== false, verbose });
    if (p.kind === 'random') {
      const legal = task.legalActions(s), a = randChoice(legal);
      if (!verbose) return { a, kind: 'random' };
      return { a, kind: 'random', algo: 'none', state: s, legal, playerName: 'Random',
        items: legal.map(x => ({ a: x, value: 0, visits: 0 })),
        text: `Random player: picked ${task.actionLabel(a)} uniformly among ${legal.length} legal moves. No memory, no learning.` };
    }
    if (p.kind === 'perfect') {
      const av = Solver.actionValues(task, s), a = Solver.pick(av);
      if (!verbose) return { a, kind: 'perfect' };
      const o = outcomeOf(av.find(x => x.a === a).v);
      return { a, kind: 'perfect', algo: 'solver', state: s, legal: av.map(x => x.a), playerName: 'Perfect solver',
        items: av.map(x => ({ a: x.a, value: x.v, visits: 0 })),
        text: `Perfect solver: searched the entire game tree. ${task.actionLabel(a)} ` +
          (o > 0 ? 'forces a win as fast as possible.' : o < 0 ? 'loses against perfect play — but so does every move, so it resists as long as possible.' : 'guarantees at least a draw.') };
    }
    return null;  // human
  }
  play(a, decision = null) {
    if (this.over) throw new Error('Game is already over');
    const task = this.task, s = this.state, pi = this.current, p = this.players[pi];
    if (!task.legalActions(s).includes(a)) throw new Error('Illegal action ' + a);
    const key = task.getState(s);
    this.lastUpdates = [];
    let move = null;
    if (this.record) {
      const vb = p.kind === 'brain' ? p.brain : this.observer;
      let before = null, algo = null;
      if (p.kind === 'brain') { before = decision && decision.items ? decision.items : vb.evaluate(s).items; algo = vb.algorithm; }
      else if (vb) { before = vb.evaluate(s).items; algo = vb.algorithm; }
      else if (decision) { before = decision.items; algo = decision.algo; }
      move = { index: this.moves.length, player: pi, playerKind: p.kind, name: playerLabel(p), key, state: s, a,
        decision, before, algo, valueBrain: vb, opinionOf: p.kind !== 'brain' && vb ? vb.name : null, updates: [], after: null };
      this.moves.push(move);
    }
    if (p.kind === 'brain' && p.learn) {
