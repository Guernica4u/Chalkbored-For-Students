    if (k[3] === 'x') return 'Where should the first log go?';
    let s = `The house has ${['', '1-3', '4-7', '8-11', '12+'][+k[5]]} logs; this wall is ${k[1] === '4' ? '4+' : k[1]} long`;
    s += k[2] === 'n' ? ' and it bends left more than right.' : ` with ${k[2] === '4' ? '4+' : k[2]} right turn${k[2] === '1' ? '' : 's'}.`;
    s += ` The open end is ${['very close to', 'close to', 'a few steps from', 'far from'][+k[3]]} where it started.`;
    s += k[4] === '0' ? ' No doorway yet.' : k[4] === '1' ? ' There is a doorway.' : ' There are too many openings.';
