  },
  step(s) { return s; },
  isTerminal() { return false; },
  winner() { return null; },
  reward() { return 0; },
  actionLabel(a) { return FOREST_MOVES[a]; },
  sayMove(a) { return FOREST_MOVES[a]; },
  stateFromKey(k) { return { key: k }; },
  isValidKey(k) { return typeof k === 'string' && (/^D[01]{6}[0-2]$/.test(k) || /^P[0-4][n0-4][0-3x][0-2][0-4][01]$/.test(k)); },
  caption(k) {
    if (k[0] === 'P') return k[3] === 'x' ? 'placing: first log' : `placing: run ${k[1]}, turns ${k[2]}, ${['very close', 'close', 'mid', 'far'][+k[3]]}`;
    const inv = ['axe', 'stick', 'stone', 'log'].filter((_, i) => k[i + 1] === '1').join('+') || 'empty hands';
    return `${inv}${k[6] === '1' ? ' · loose joint' : ''} · ${['no walls', 'house started', 'house big'][+k[7]]}`;
