/* ---------- environments: each has its own learning agents and its own tabs ---------- */
const ENVIRONMENTS = [
  { id: 'tictactoe', name: 'Tic-Tac-Toe', starters: [['Alpha', 'qlearning'], ['Beta', 'qlearning'], ['Menace', 'menace']] },
  { id: 'room', name: 'Room', starters: [['Ada'], ['Bo'], ['Cy']] },
  { id: 'forest', name: 'Forest', starters: [['Ash'], ['Fern'], ['Rowan']] },
  { id: 'nim', name: 'Nim', advancedOnly: true, starters: [['Nimbo', 'qlearning']] },
];
/** Make sure an environment has at least one learning agent (creates its starter agents). */
function ensureBrains(env) {
  if (App.brains.some(b => b.taskId === env)) return;
  const e = ENVIRONMENTS.find(x => x.id === env);
  for (const [name, algo] of e.starters)
    App.brains.push(new Brain({ name: uniqueName(name), taskId: env, algorithm: algo || 'qlearning', hyper: WORLD_HYPER[env] }));
  markDirty();
}
function setEnv(env) {
  if (!ENVIRONMENTS.some(e => e.id === env)) env = 'tictactoe';
  Train.stop(); WorldTrain.stop(); Room.setRunning(false); Forest.setRunning(false);
  App.env = env;
  ensureBrains(env);
  const remembered = brainById(App.activeByEnv[env]);
  App.activeId = remembered && remembered.taskId === env ? remembered.id : App.brains.find(b => b.taskId === env).id;
  App.activeByEnv[env] = App.activeId;
  const world = TASKS[env].kind === 'world';
  document.body.dataset.kind = world ? 'world' : 'board';
  document.body.dataset.env = env;
  refreshPickers();
  Explorer.selected = null; Explorer.page = 0;
  if (world) WORLDS[env].live().env = null;
  else { Play.newGame(); Watch.setup(); Train.render(); }
  const tabs = world ? [env, 'rtrain', 'brain'] : ['play', 'train', 'watch', 'brain'];
  switchTab(tabs.includes(App.tab) ? App.tab : tabs[0]);
  Settings.save(); markDirty();
}

