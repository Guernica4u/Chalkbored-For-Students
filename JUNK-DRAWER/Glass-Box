      }
    }
    for (const a of this.agents) {
      if (a.ko > 0) {
        a.ko -= dt;
        if (a.ko <= 0) { a.ko = 0; a.hp = 100; a.action = null; this.note(a, 'I feel better now.', 'info'); }
        continue;
      }
      const act = a.action;
      if (!act) continue;
      act.t -= dt;
      if (act.type === 'move') {
        if (act.snap) this.setFacing(a, act.angle);   // keyboard control: face the new direction at once
        const off = this.turnToward(a, act.angle, dt);
        if (off < 0.6) {
          const sp = ROOM.SPEED * (b.heldBy === a ? 0.6 : 1) * dt;
          const dx = Math.cos(a.facing) * sp, dy = Math.sin(a.facing) * sp;
          let moved = false, hit = null;
          for (let [mx, my] of [[dx, 0], [0, dy]]) {
            if (Math.abs(mx) + Math.abs(my) < 1e-6) continue;
            let why = this.blocked(a, a.x + mx, a.y + my, a.facing);
            if (why) {   // blocked: creep up until touching instead of stopping short
              hit = why;
              for (let k = 0; k < 6 && why; k++) { mx /= 2; my /= 2; why = this.blocked(a, a.x + mx, a.y + my, a.facing); }
              if (why) continue;
            }
            a.x += mx; a.y += my;
            if (!hit) moved = true;
          }
          if (!moved && hit) { act.t = 0; a.bumped = true; if (!act.quiet) a.thought = `Bumped into ${hit}.`; }
        } else if (off === Infinity) { act.t = 0; a.bumped = true; }
      } else if (act.type === 'turn') {
        if (this.turnToward(a, act.angle, dt) < 1e-3) act.t = 0;
      } else if (act.type === 'look') {
        this.setFacing(a, a.facing + (2 * Math.PI / 1.6) * dt);
      }
      if (act.t <= 0) { a.action = null; if (act.type === 'look') this.finishLook(a); }
    }
    if (b.heldBy) { const p = this.heldPos(b.heldBy); b.x = p.x; b.y = p.y; }
    this.button.pressed = !b.broken && !b.heldBy && this.onButton(b);
    if (this.button.pressed) {
      this.done = true; this.doneTimer = this.pauseTime;
      const w = b.lastTouch;
      this.winner = w;
      this.stats.wins++; this.stats.winTimes.push(this.t);
      if (w) { this.per[w.name].wins++; this.note(w, 'Click! The box is on the button. I did it!', 'win', 1); }
      else this.note(null, 'The box is on the button!', 'win');
