  render(container, s, opts = {}) {
    const mini = !!opts.mini, ann = opts.annotations || {};
    container.innerHTML = '';
    container.className = 'board roomstate forest' + (mini ? ' mini' : '');
    if (!mini) { const p = document.createElement('div'); p.className = 'rs-desc'; p.textContent = describeForestKey(s.key); container.appendChild(p); }
    const grid = document.createElement('div'); grid.className = 'rs-grid';
