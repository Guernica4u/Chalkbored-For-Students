    if (!this.running) return;
    this.running = false;
    $('#rtStop').disabled = true;
    if (this.trainer && this.trainer.sinceEval > 3) this.trainer.checkpoint();
    markDirty(); saveAll();
    if (App.env === this.env) WORLDS[this.env].live().build();
    this.render();
  },
  render() {
    if (!WORLDS[App.env]) return;
    const W = this.world(), names = this.names(), brains = worldBrainMap(names, App.env), list = Object.values(brains);
    const main = brains[activeBrain().name] || list[0];
    $('#rtWho').textContent = names.join(', ');
    $('#rtLiveName').textContent = W.tabName;
    $('#rtIntro').textContent = W.intro;
    $('#rtNote').textContent = W.note;
    $('#rtLegend').innerHTML = `<span><i style="background:#fff"></i>${W.legend[0]}</span><span><i style="background:#777"></i>${W.legend[1]}</span>`;
    const h = main && main.history[main.history.length - 1];
    const who = names.length > 1 ? names.slice(0, -1).join(', ') + ' and ' + names[names.length - 1] : names[0];
    $('#rtSimple').textContent = !main || (!main.stats.gamesPlayed && !h) ? W.fresh(who)
      : `${who} ${names.length > 1 ? 'have' : 'has'} practiced ${fmtInt(main.stats.gamesPlayed)} rounds.` + (h ? W.progress(h) : '') +
        (this.running ? ` Practicing... ${fmtInt(this.trainer.rounds)} of ${fmtInt(this.goal)} rounds done.` : '');
    $('#rtRate').textContent = this.running ? `${fmtInt(this.trainer.rounds / Math.max(0.001, (performance.now() - this.t0) / 1000))} rounds/s` : '';
    if (App.tab === 'rtrain' && main) drawChart($('#rchart'), main.history);
    $('#rtTable').innerHTML = `<tr><th>Learning agent</th><th>Rounds</th><th>Wins</th><th>Situations known</th><th>ε</th></tr>` +
      list.map(b => `<tr><td><b>${escapeHtml(b.name)}</b></td><td class="mono">${fmtInt(b.stats.gamesPlayed)}</td><td class="mono">${fmtInt(b.stats.wins)}</td><td class="mono">${b.table.size}</td><td class="mono">${b.hyper.epsilon.toFixed(3)}</td></tr>`).join('');
  },
};

/* ---------- persistence (localStorage, all wrapped in try/catch) ---------- */
function saveAll() {
  if (!App.dirty) return;
  try {
    const now = new Date().toISOString();
    const payload = {
      v: 1, activeId: App.activeId, activeByEnv: App.activeByEnv,
      brains: App.brains.map(b => {
        if (b._savedRev !== b.revision) { b.stats.updated = now; b._savedRev = b.revision; }
        const j = brainToJSON(b); j.id = b.id; return j;
      }),
    };
    localStorage.setItem(LS_KEY, JSON.stringify(payload));
    App.dirty = false;
    $('#saveStatus').textContent = '● auto-saved';
    $('#saveStatus').title = 'Saved to this browser at ' + new Date().toLocaleTimeString();
  } catch (e) {
    $('#saveStatus').textContent = '⚠ not saved';
    $('#saveStatus').title = 'Auto-save failed: ' + e.message + ' — export your brains to keep them.';
  }
}
function loadAll() {
  let raw = null;
  try { raw = localStorage.getItem(LS_KEY); } catch (e) { $('#saveStatus').textContent = '⚠ storage unavailable'; }
  if (!raw) return false;
  try {
    const payload = JSON.parse(raw);
    const skipped = [];
    for (const j of payload.brains || []) {
      const res = parseBrainFile(j);
      if (!res.ok) { skipped.push(j && j.name); continue; }
      const b = brainFromData(res.data, { id: typeof j.id === 'string' ? j.id : undefined });
      b._savedRev = b.revision;
      App.brains.push(b);
    }
    if (skipped.length) setTimeout(() => toast(`Skipped ${skipped.length} damaged saved brain(s).`, 4000), 500);
    App.activeId = payload.activeId;
    if (payload.activeByEnv && typeof payload.activeByEnv === 'object') App.activeByEnv = payload.activeByEnv;
    return App.brains.length > 0;
  } catch (e) { return false; }
}

/* ---------- boot ---------- */
function boot() {
  loadAll();
  for (const e of ENVIRONMENTS) if (!e.advancedOnly) ensureBrains(e.id);
  if (!brainById(App.activeId)) App.activeId = App.brains[0].id;
  $$('nav.tabs button').forEach(b => b.onclick = () => switchTab(b.dataset.tab));
  $('#activeAi').onchange = e => setActive(e.target.value);
  $('#newAiBtn').onclick = () => newAiDialog();
  $('#envPick').onchange = e => setEnv(e.target.value);
  $('#settingsBtn').onclick = settingsDialog;
  $('#modal').addEventListener('mousedown', e => { if (e.target.id === 'modal') closeModal(); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });

  // drag & drop anywhere
  let dragDepth = 0;
  const hasFiles = e => e.dataTransfer && Array.from(e.dataTransfer.types || []).includes('Files');
  window.addEventListener('dragenter', e => { if (!hasFiles(e)) return; e.preventDefault(); dragDepth++; $('#dropOverlay').classList.add('show'); });
  window.addEventListener('dragover', e => { if (hasFiles(e)) e.preventDefault(); });
  window.addEventListener('dragleave', e => { if (!hasFiles(e)) return; if (--dragDepth <= 0) { dragDepth = 0; $('#dropOverlay').classList.remove('show'); } });
  window.addEventListener('drop', e => {
    if (!hasFiles(e)) return;
    e.preventDefault(); dragDepth = 0;
    $('#dropOverlay').classList.remove('show'); $('#dropzone').classList.remove('hot');
    const f = e.dataTransfer.files[0];
    if (f) readFileAndImport(f);
  });

  Settings.load();
  document.body.classList.toggle('advanced', App.advanced);
  document.body.classList.toggle('simple', !App.advanced);
  Play.init(); Train.init(); Watch.init(); BrainTab.init(); Room.init(); Forest.init(); WorldTrain.init();
  if (!App.activeByEnv[App.env] && brainById(App.activeId)) App.activeByEnv[brainById(App.activeId).taskId] = App.activeId;
  setEnv(App.env);
  setInterval(saveAll, 3000);
  window.addEventListener('beforeunload', saveAll);
  document.addEventListener('visibilitychange', () => { if (document.hidden) saveAll(); });
  saveAll();
}

if (typeof document !== 'undefined' && document.getElementById('playBoard')) boot();
if (typeof module !== 'undefined' && module.exports)   // lets the logic be unit-tested in Node
  module.exports = { ForestEnv, ForestRunner, ForestTrainer, evaluateForest, evaluateHouse, houseArtSVG, floorPlanSVG, FOREST, FOREST_HYPER, RoomTrainer, evaluateRoom, ROOM_HYPER, RoomRunner, RoomEnv, ROOM, MindlessPolicy, speak, endSpeech, TASKS, Brain, GameSession, Trainer, Solver, evaluateBrain, brainToJSON, stringifyBrainFile, parseBrainFile, brainFromData, mergeBrain, replaceBrain, tttResult, App };
</script>
