}
/** Human-friendly but compact text: metadata pretty-printed, one table entry per line. */
function stringifyBrainFile(obj) {
  const { table, history, ...meta } = obj;
  let out = JSON.stringify(meta, null, 2).slice(0, -2);
  out += ',\n  "history": [' + (history.length ? '\n' + history.map(r => '    ' + JSON.stringify(r)).join(',\n') + '\n  ' : '') + ']';
  const keys = Object.keys(table);
  out += ',\n  "table": {' + (keys.length ? '\n' + keys.map(k => `    ${JSON.stringify(k)}: ${JSON.stringify(table[k])}`).join(',\n') + '\n  ' : '') + '}\n}\n';
  return out;
}

/** Validate a brain file (string or parsed object). Returns {ok, data} or {ok:false, errors}. */
function parseBrainFile(input) {
  const fail = (...errors) => ({ ok: false, errors });
  let obj = input;
  if (typeof input === 'string') {
    if (!input.trim()) return fail('The file is empty.');
    try { obj = JSON.parse(input); }
    catch (e) { return fail(`Corrupted file: it is not valid JSON (${e.message}). It may be truncated or damaged.`); }
  }
  if (!obj || typeof obj !== 'object' || Array.isArray(obj)) return fail('Corrupted file: expected a JSON object at the top level.');
  if (obj.format !== FORMAT_NAME)
    return fail(`Not a Glass Box brain file: "format" should be "${FORMAT_NAME}" but ${obj.format ? `it is "${String(obj.format).slice(0, 40)}"` : 'it is missing'}.`);
  const fv = obj.formatVersion;
  if (!Number.isInteger(fv) || fv < 1) return fail('Corrupted file: "formatVersion" is missing or not a positive integer.');
  if (fv > FORMAT_VERSION)
    return fail(`Wrong version: this brain uses format v${fv}, but this app only understands up to v${FORMAT_VERSION}. Use a newer version of the app.`);
  const task = TASKS[obj.taskId];
  if (!task) return fail(`Wrong task: this brain was trained on an unknown task "${String(obj.taskId).slice(0, 40)}". This app knows: ${Object.values(TASKS).map(t => `"${t.id}" (${t.name})`).join(', ')}.`);
  if (obj.taskVersion != null && obj.taskVersion !== task.version)
    return fail(`Wrong task version: the brain was trained on ${task.name} rules v${obj.taskVersion}, but this app has v${task.version}. The state encoding may differ.`);
  if (!ALGORITHMS[obj.algorithm]) return fail(`Unknown algorithm "${String(obj.algorithm).slice(0, 40)}". Supported: ${Object.keys(ALGORITHMS).join(', ')}.`);
  if (!obj.table || typeof obj.table !== 'object' || Array.isArray(obj.table)) return fail('Corrupted file: "table" is missing or is not an object.');
  if (obj.checksum != null) {
    const cs = fnv1a(JSON.stringify(obj.table));
    if (cs !== obj.checksum)
      return fail(`Corrupted file: checksum mismatch (file says ${String(obj.checksum).slice(0, 16)}, content gives ${cs}). The Q-table was damaged or modified.`,
        'If you edited the table on purpose, delete the "checksum" line and import again.');
  }
  const errors = [], table = new Map();
  let bad = 0;
  const keys = Object.keys(obj.table);
  for (const key of keys) {
    const arr = obj.table[key];
    const err = msg => { bad++; if (errors.length < 6) errors.push(`State "${key.slice(0, 30)}": ${msg}`); };
    if (!task.isValidKey(key)) { err(`is not a valid ${task.name} state.`); continue; }
    if (!Array.isArray(arr) || arr.length % 3 !== 0) { err('must be a flat array of [action, value, visits] triples.'); continue; }
    const st = task.stateFromKey(key);
    if (task.isTerminal(st)) { err('is a finished game (no moves possible).'); continue; }
    const legal = new Set(task.legalActions(st));
    let ok = true;
    for (let i = 0; i < arr.length && ok; i += 3) {
      const a = arr[i], v = arr[i + 1], n = arr[i + 2];
      if (!Number.isInteger(a) || !legal.has(a)) { err(`action ${JSON.stringify(a)} is not a legal move there.`); ok = false; }
      else if (typeof v !== 'number' || !Number.isFinite(v) || (obj.algorithm === 'menace' && v < 0)) { err(`value for action ${a} is not a valid number.`); ok = false; }
      else if (!Number.isInteger(n) || n < 0 || n > 0xffffffff) { err(`visit count for action ${a} must be a non-negative integer.`); ok = false; }
    }
    if (ok) table.set(key, arr);
  }
  if (bad) return { ok: false, errors: [`Corrupted file: ${bad} of ${keys.length} table entries are invalid.`, ...errors] };

  const warnings = [], hyper = Object.assign({}, DEFAULT_HYPER);
  const hp = obj.hyperparameters && typeof obj.hyperparameters === 'object' ? obj.hyperparameters : {};
  for (const k of Object.keys(DEFAULT_HYPER)) {
    if (hp[k] == null) continue;
    const v = hp[k], [lo, hi] = HYPER_LIMITS[k];
    if (typeof v === 'number' && Number.isFinite(v) && v >= lo && v <= hi) hyper[k] = v;
    else warnings.push(`Hyperparameter "${k}" was invalid (${JSON.stringify(v)}); using default ${DEFAULT_HYPER[k]}.`);
  }
  const st = obj.stats && typeof obj.stats === 'object' ? obj.stats : {};
  const stats = {};
  for (const k of ['gamesPlayed', 'wins', 'losses', 'draws', 'selfPlayGames', 'taughtMoves'])
    stats[k] = Number.isInteger(st[k]) && st[k] >= 0 ? st[k] : 0;
  for (const k of ['created', 'updated']) if (typeof st[k] === 'string') stats[k] = st[k].slice(0, 40);
  const history = Array.isArray(obj.history) ? obj.history.filter(r => Array.isArray(r) && r.length >= 5 && typeof r[0] === 'number')
    .map(r => ({ g: r[0], win: r[1], loss: r[2], opt: r[3], avgR: r[4] })) : [];
  return {
    ok: true, warnings,
    data: {
      name: typeof obj.name === 'string' && obj.name.trim() ? obj.name.trim().slice(0, 40) : 'Imported',
      taskId: task.id, algorithm: obj.algorithm, hyper, stats, history, table,
      revision: Number.isInteger(obj.brainRevision) ? obj.brainRevision : 0,
      exportedAt: obj.exportedAt, stateCount: table.size,
    },
  };
}
function loadTableInto(brain, table) {
  const task = brain.task;
  for (const [key, arr] of table) {
    const e = brain.entry(key, task.stateFromKey(key));
    for (let i = 0; i < arr.length; i += 3) { e.q[arr[i]] = arr[i + 1]; e.n[arr[i]] = arr[i + 2]; }
  }
}
function brainFromData(data, overrides = {}) {
  const b = new Brain(Object.assign({ name: data.name, taskId: data.taskId, algorithm: data.algorithm, hyper: data.hyper,
    stats: data.stats, history: data.history, revision: data.revision }, overrides));
