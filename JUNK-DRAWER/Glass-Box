    s += `<circle cx="${x0}" cy="${yy - 3}" r="3" fill="#bdbdbd" stroke="#555" stroke-width="0.7"/><circle cx="${x0 + w}" cy="${yy - 3}" r="3" fill="#bdbdbd" stroke="#555" stroke-width="0.7"/>`;
  }
