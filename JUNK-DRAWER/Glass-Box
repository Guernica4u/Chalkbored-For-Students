    const last = walls[walls.length - 1];
    closeGap = Math.min(...walls.slice(0, -2).map(w => pointSegDist(last.x2, last.y2, w)));
    if (closeGap > 0.03) {
      if (!doors.length && closeGap >= 0.6 && closeGap <= 1.3) doorWidth = closeGap;   // the last opening works as a door
