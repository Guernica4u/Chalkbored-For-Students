/* ---------- judging a house from its real log geometry ---------- */
function pointSegDist(px, py, w) {
  const dx = w.x2 - w.x1, dy = w.y2 - w.y1, L2 = dx * dx + dy * dy;
  const t = L2 ? clamp(((px - w.x1) * dx + (py - w.y1) * dy) / L2, 0, 1) : 0;
  return Math.hypot(px - (w.x1 + t * dx), py - (w.y1 + t * dy));
}
/**
 * walls: [{x1,y1,x2,y2, gap, door, doorGap}], plot: {x, y, size}.
 * Encloses? Rasterise the logs (10 cm cells), close small gaps (anything up to a doorway),
 * flood-fill the outside air; whatever the air can't reach is the inside.
 */
function evaluateHouse(walls, plot) {
  const C = 0.1, R = 4, PADC = R + 2;   // 10 cm cells; close gaps up to ~0.8 m (a doorway)
  const N = Math.ceil(plot.size / C) + 2 * PADC, ox = plot.x - plot.size / 2 - PADC * C, oy = plot.y - plot.size / 2 - PADC * C;
  const wood = new Uint8Array(N * N), outside = new Uint8Array(N * N);
