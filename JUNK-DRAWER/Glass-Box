  html += `<div class="reason ${d.kind}">${escapeHtml(d.text)}</div>`;
  const sorted = (d.sorted || d.items.slice().sort((x, y) => y.value - x.value)).slice(0, 12);
  if (d.algo !== 'none') {
    const max = Math.max(1e-9, ...d.items.map(i => i.value));
    html += `<table class="opts"><tr><th></th><th>Move</th><th>${d.algo === 'menace' ? 'Beads' : d.algo === 'solver' ? 'Outcome' : 'Q-value'}</th><th></th>${d.algo === 'solver' ? '' : '<th>Tried</th>'}</tr>` +
      sorted.map(i => `<tr class="${i.a === d.a ? 'sel' : ''}"><td>${i.a === d.a ? '★' : ''}</td><td>${escapeHtml(L(i.a))}</td>
        <td class="mono">${fmtVal(i.value, d.algo)}</td><td>${d.algo === 'solver' ? '' : valueBar(i.value, d.algo, max)}</td>${d.algo === 'solver' ? '' : `<td class="mono">${fmtInt(i.visits)}</td>`}</tr>`).join('') + `</table>`;
    if (d.items.length > sorted.length) html += `<div class="small muted">…and ${d.items.length - sorted.length} more</div>`;
  }
  if (opts.onTeach && !opts.thinking) html += `<div class="teach">Teach: was ${escapeHtml(L(d.a))} a good move?
      <button class="small" data-teach="1">👍 Good</button><button class="small" data-teach="0">👎 Bad</button></div>`;
  root.innerHTML = html;
  $$('[data-teach]', root).forEach(btn => btn.onclick = () => opts.onTeach(btn.dataset.teach === '1'));
}

function logItem(list, html, cls = '') {
  const li = document.createElement('li');
  if (cls) li.className = cls;
  li.innerHTML = html;
  list.appendChild(li);
  while (list.children.length > 400) list.removeChild(list.firstChild);
  list.scrollTop = list.scrollHeight;
}
function logMove(list, task, move) {
  const d = move.decision;
  const tag = `<span class="tag p${move.player}">${escapeHtml(task.playerNames[move.player])}</span><b>${escapeHtml(move.name)}</b>: `;
  if (!d) logItem(list, tag + (App.advanced ? `played ${escapeHtml(task.actionLabel(move.a))}.` : `took ${escapeHtml(sayMove(task, move.a))}.`));
  else if (!App.advanced && d.say) logItem(list, tag + escapeHtml(d.say));
  else logItem(list, tag + escapeHtml(d.text));
}

/* ---------- plain-English inner monologue (simple mode) ---------- */
const pickOne = arr => arr[randInt(arr.length)];
function oppWords(name) {
  return name === 'you' ? { subj: 'you', Subj: 'You', obj: 'you', has: 'have', s: '' } : { subj: name, Subj: name, obj: name, has: 'has', s: 's' };
}
function sayMove(task, a) { return task.sayMove ? task.sayMove(a) : task.actionLabel(a); }
function timesWords(n) {
  return n < 3 ? 'once or twice' : n < 20 ? 'a few times' : n < 200 ? `about ${Math.max(20, Math.round(n / 10) * 10)} times` : n < 2000 ? 'hundreds of times' : 'thousands of times';
}
/** What the player "says to itself" about decision d. oppName is 'you' or the opponent's name. */
function speak(task, d, oppName) {
  const o = oppWords(oppName), mv = sayMove(task, d.a);
  if (d.kind === 'random') return pickOne([`I don't really think. I just pick any move... ${mv}, why not.`, `Random time! ${mv}.`, `Eeny, meeny, miny... ${mv}.`]);
  if (d.kind === 'perfect') {
    const v = outcomeOf(d.items.find(i => i.a === d.a).value);
    return `I've worked out every possible game from here. ${mv[0].toUpperCase() + mv.slice(1)} is ${v > 0 ? 'a sure win for me' : v < 0 ? `the best I can do, but I lose if ${o.subj} play${o.s} perfectly` : 'at least a draw'}.`;
  }
  const parts = [];
  if (d.kind === 'forced') parts.push('Only one move left.');
  else if (d.kind === 'explore') parts.push(pickOne(['Let me try something different and see what happens...', "I'll experiment this time instead of playing my best move.", 'Time to test a random idea!']));
  else if (d.kind === 'sample') parts.push(d.known ? 'I shook my matchbox and drew a bead.' : "New position, so every move has the same number of beads. I'll just draw one.");
  else if (!d.known) parts.push(pickOne(["Hmm, I've never seen this board before, so I'll have to guess.", 'This position is new to me...']));
  else parts.push(`I've seen this position ${timesWords(d.visits)} before.`);
  if (task.tactics) parts.push(...task.tactics(d.state, d.a, o));
  if (d.algo === 'qlearning' && d.kind === 'exploit' && d.known) {
    const v = d.chosen.value;
    if (v > 0.7) parts.push("I'm pretty sure this wins.");
    else if (v > 0.3) parts.push('This feels like a good move.');
    else if (v < -0.5) parts.push("Everything looks bad... I'll pick the least bad option.");
    else if (Math.abs(v) < 0.15 && d.visits > 30) parts.push('This will probably end in a draw.');
    else if (d.bestCount > 1) parts.push('A few moves look equally good to me.');
  }
  if (!parts.join(' ').includes(mv)) parts.push(`I'll take ${mv}.`);
  return parts.join(' ');
}
/** End-of-game remark from the agent playing side pi. */
function endSpeech(task, g, pi, oppName) {
  const o = oppWords(oppName), r = task.reward(g.state, pi);
  let t = r > 0 ? pickOne(['Yes! I won!', 'Got it, I win!']) : r < 0 ? pickOne([`${o.Subj} got me.`, `Ouch, ${o.subj} won.`]) : pickOne(['A draw. Nobody wins this time.', "It's a draw."]);
  const mine = g.moves.filter(m => m.player === pi && m.playerKind === 'brain');
  const learned = mine.some(m => m.updates.some(u => u.why !== 'teach'));
  const last = mine[mine.length - 1];
  if (!learned) t += " (I'm not learning right now, so I won't remember this game.)";
  else if (r < 0 && last) t += ` Note to self: ${sayMove(task, last.a)} in that spot was a mistake. I'll like it less next time.`;
  else if (r > 0 && last) t += ` I'll remember that ${sayMove(task, last.a)} worked there.`;
  else t += " I'll remember how this one went.";
  return t;
}
/** Thought panel: detailed numbers in advanced mode, a speech bubble in simple mode. */
function showThought(root, d, task, opts = {}) {
  root._thought = [d, task, opts];
  if (App.advanced) return renderThought(root, d, task, opts);
  const name = opts.speaker || (d && d.playerName) || '';
  let html = `<div class="speaker"><div class="face">${escapeHtml((name[0] || '?').toUpperCase())}</div><b>${escapeHtml(name)}</b>${opts.thinking ? ' <span class="muted small dots">thinking</span>' : ''}</div>`;
  const text = opts.say || (d && (d.say || d.text));
  html += text ? `<div class="bubble ${opts.thinking ? 'thinking' : ''}">${escapeHtml(text)}</div>` : `<div class="bubble thinking">${escapeHtml(opts.emptySimple || 'Waiting for my turn.')}</div>`;
  if (d && !opts.say && d.confidence != null && d.kind !== 'forced')
    html += `<div class="sure">How sure: ${d.confidence > 0.75 ? 'very sure' : d.confidence > 0.4 ? 'fairly sure' : 'not sure at all'}</div>`;
  if (d && opts.onTeach && !opts.thinking)
    html += `<div class="teach">Was ${escapeHtml(sayMove(task, d.a))} a good move? <button class="small" data-teach="1">👍 Good</button><button class="small" data-teach="0">👎 Bad</button></div>`;
  root.innerHTML = html;
  $$('[data-teach]', root).forEach(btn => btn.onclick = () => opts.onTeach(btn.dataset.teach === '1'));
}
function teachMessage(task, u) {
  if (App.advanced) return describeUpdate(task, u);
  return u.good ? `Got it! I'll like ${sayMove(task, u.a)} more there.` : `Okay, I'll avoid ${sayMove(task, u.a)} there.`;
}
function logUpdates(list, task, ups) {
  for (const u of ups) logItem(list, '↻ ' + escapeHtml(describeUpdate(task, u)), 'upd');
}
function resultText(task, w, perspective) {
  if (w == null) return '';
  if (w === -1) return 'Draw.';
  if (perspective) return perspective(w);
  return `${task.playerNames[w]} wins!`;
}

/* ---------- replay / timeline component ---------- */
class ReplayView {
  constructor(root, opts = {}) {
    this.root = root; this.opts = opts; this.game = null; this.idx = 0; this.mode = 'before'; this.follow = true;
    root.innerHTML = `<h3>${opts.title || 'Replay & learning timeline'}</h3>
      <div class="row small">
        <button data-nav="first" class="small">⏮</button><button data-nav="prev" class="small">◀</button>
        <input type="range" class="rp-range" min="0" max="0" value="0" style="flex:1;min-width:120px">
        <button data-nav="next" class="small">▶</button><button data-nav="last" class="small">⏭</button>
        <span class="seg"><button data-mode="before" class="on small">Before</button><button data-mode="after" class="small">After learning</button></span>
      </div>
      <div class="chips"></div>
      <div class="replay-grid"><div class="replay-board"><div class="rp-b"></div></div><div class="rp-detail small"></div></div>`;
    this.$range = $('.rp-range', root); this.$chips = $('.chips', root);
    this.$board = $('.rp-b', root); this.$detail = $('.rp-detail', root);
    $$('[data-nav]', root).forEach(b => b.onclick = () => this.nav(b.dataset.nav));
    $$('[data-mode]', root).forEach(b => b.onclick = () => { this.mode = b.dataset.mode; this.render(); });
    this.$range.oninput = () => { this.idx = +this.$range.value; this.follow = this.idx === this.max; this.render(); };
    this.render();
  }
  get max() { return this.game ? this.game.moves.length : 0; }
  setGame(g) { this.game = g; this.idx = 0; this.follow = true; this.refresh(); }
  refresh() { if (this.follow) this.idx = this.max; this.idx = clamp(this.idx, 0, this.max); this.render(); }
  nav(where) {
    if (where === 'first') this.idx = 0;
    else if (where === 'prev') this.idx = Math.max(0, this.idx - 1);
    else if (where === 'next') this.idx = Math.min(this.max, this.idx + 1);
    else this.idx = this.max;
    this.follow = this.idx === this.max;
    this.render();
  }
  render() {
    $$('[data-mode]', this.root).forEach(b => b.classList.toggle('on', b.dataset.mode === this.mode));
    const g = this.game;
    if (!g || !g.moves.length) {
      this.$range.max = 0; this.$chips.innerHTML = ''; this.$board.innerHTML = '';
      this.$detail.innerHTML = `<p class="muted">${this.opts.empty || 'Moves appear here as the game is played. After the game you can step through every decision and see how the values changed.'}</p>`;
      return;
    }
    const task = g.task;
    this.$range.max = this.max; this.$range.value = this.idx;
    this.$chips.innerHTML = g.moves.map((m, i) => {
      const k = m.decision ? m.decision.kind : m.playerKind === 'human' ? 'human' : m.playerKind;
      return `<span class="chip k-${k} ${i === this.idx ? 'on' : ''}" data-i="${i}" title="${escapeHtml(m.name + ': ' + task.actionLabel(m.a))}">${i + 1}. ${escapeHtml(task.playerNames[m.player])} ${escapeHtml(task.actionLabel(m.a).replace(/^(corner|edge|center) /, ''))}</span>`;
    }).join('') + `<span class="chip ${this.idx === this.max ? 'on' : ''}" data-i="${this.max}">${g.over ? 'result' : 'now'}</span>`;
    $$('.chip', this.$chips).forEach(c => c.onclick = () => { this.idx = +c.dataset.i; this.follow = this.idx === this.max; this.render(); });

    if (this.idx >= this.max) {
      const s = g.state;
      const last = g.moves[g.moves.length - 1];
      task.render(this.$board, s, { lastAction: last ? last.a : null });
      let html = `<p><b>${g.over ? 'Final position — ' + escapeHtml(resultText(task, g.winner, this.opts.perspective)) : 'Current position (game in progress)'}</b></p>`;
      const ups = g.moves.flatMap(m => m.updates);
      if (ups.length) {
        const total = ups.reduce((s, u) => s + Math.abs(u.after - u.before), 0);
        html += `<p>${ups.length} value update${ups.length === 1 ? '' : 's'} this game (total change ${total.toFixed(2)}):</p><ul>` +
          ups.map(u => `<li>move ${u.mi + 1}: ${escapeHtml(describeUpdate(task, u))}</li>`).join('') + '</ul>';
      } else html += `<p class="muted">${g.over ? 'No learning happened in this game (learning was off, or no learning agent played).' : 'Learning updates appear as the game progresses.'}</p>`;
      this.$detail.innerHTML = html;
      return;
    }
    const m = g.moves[this.idx];
    const items = this.mode === 'after' && m.after ? m.after : m.before;
    task.render(this.$board, m.state, { annotations: makeAnnotations(items, m.algo, task), highlight: m.a });
    const beforeMap = new Map((m.before || []).map(i => [i.a, i])), afterMap = new Map((m.after || []).map(i => [i.a, i]));
    let html = `<p><span class="tag p${m.player}">${escapeHtml(task.playerNames[m.player])}</span><b>Move ${this.idx + 1}: ${escapeHtml(m.name)}</b> played <b>${escapeHtml(task.actionLabel(m.a))}</b>
      ${m.decision && KIND_LABEL[m.decision.kind] ? `<span class="badge b-${m.decision.kind}">${KIND_LABEL[m.decision.kind]}</span>` : ''}</p>`;
    if (m.decision && m.decision.text && m.playerKind !== 'human') html += `<div class="reason ${m.decision.kind}">${escapeHtml(m.decision.text)}</div>`;
    if (m.opinionOf) html += `<p class="muted">Values shown are ${escapeHtml(m.opinionOf)}'s opinion of this position (from the mover's point of view).</p>`;
    if (m.before && (m.algo === 'qlearning' || m.algo === 'menace')) {
      const rows = (m.before || []).slice().sort((x, y) => y.value - x.value);
      html += `<table class="opts"><tr><th></th><th>Move</th><th>Before</th><th>After</th><th>Δ</th><th>Tried</th></tr>` + rows.map(r => {
        const af = afterMap.get(r.a), bv = beforeMap.get(r.a).value;
        const dv = af ? af.value - bv : 0;
        return `<tr class="${r.a === m.a ? 'sel' : ''}"><td>${r.a === m.a ? '★' : ''}</td><td>${escapeHtml(task.actionLabel(r.a))}</td>
          <td class="mono">${fmtVal(bv, m.algo)}</td><td class="mono">${af ? fmtVal(af.value, m.algo) : '…'}</td>
          <td class="mono ${dv > 1e-6 ? 'delta-pos' : dv < -1e-6 ? 'delta-neg' : 'muted'}">${af ? (Math.abs(dv) < 1e-6 ? '·' : (dv > 0 ? '+' : '−') + Math.abs(dv).toFixed(m.algo === 'menace' ? 0 : 3)) : ''}</td>
          <td class="mono">${r.visits}${af && af.visits !== r.visits ? '→' + af.visits : ''}</td></tr>`;
      }).join('') + '</table>';
      if (!m.after) html += `<p class="muted">"After" values appear when the game ends.</p>`;
    } else if (m.decision && m.algo === 'solver') html += `<p class="muted">Solver values: exact game-theoretic outcomes.</p>`;
    if (m.updates.length) html += `<p><b>What it learned about this move:</b></p><ul>` + m.updates.map(u => `<li>${escapeHtml(describeUpdate(task, u))}</li>`).join('') + '</ul>';
    else if (m.playerKind === 'brain') html += `<p class="muted">No update for this move${g.over ? ' (learning was off)' : ' yet — it is updated when this player moves again or the game ends'}.</p>`;
    if (m.valueBrain) html += `<div class="teach">Teach ${escapeHtml(m.valueBrain.name)}: ${escapeHtml(task.actionLabel(m.a))} here was
      <button class="small" data-teach="1">👍 good</button><button class="small" data-teach="0">👎 bad</button></div>`;
    this.$detail.innerHTML = html;
    $$('[data-teach]', this.$detail).forEach(b => b.onclick = () => {
      const good = b.dataset.teach === '1', br = m.valueBrain;
      const u = br.teach(m.state, m.a, good);
      Object.assign(u, { why: 'teach', good, menace: br.isMenace, mi: m.index });
      m.updates.push(u);
      m.after = br.evaluate(m.state).items;
      markDirty();
      toast(describeUpdate(task, u));
      this.mode = 'after'; this.render();
      if (this.opts.onTeach) this.opts.onTeach(u);
    });
  }
}

