const gauss = () => { let u = 0, v = 0; while (!u) u = Math.random(); while (!v) v = Math.random(); return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v); };

/* ---------- the forest as a learnable task ----------
   A learning agent answers two smaller questions instead of one huge one:
   "D" What should I do next?  (looks only at hands and supplies)
     key D + 7 chars: [1] has an axe [2] has a stick [3] has a stone [4] carrying a log
                      [5] logs lying on the ground [6] last joint of the house is loose     0 / 1
                      [7] house: 0 no walls, 1 1-7 logs, 2 8+ logs
     actions (only the physically possible ones are offered): 0 stick, 1 stone, 2 make axe (needs stick + stone),
              3 chop, 4 get log, 12 go and place a log (needs a log), 9 tighten (needs a loose joint), 10 drop a stick/stone
   "P" How should this log go?  (looks only at the shape of the house)
     key P + 6 chars: [1] length of the current straight wall 0-4 (4 = 4+)
                      [2] net right turns: n = more left than right, 0-4 (4 = 4+)
                      [3] open end to where the wall started: 0 <1.5 m, 1 <3 m, 2 <5 m, 3 farther, x = no walls
                      [4] doorways 0, 1, 2 = more   [5] logs in the house 0 none, 1 1-3, 2 4-7, 3 8-11, 4 12+
                      [6] would a straight log still fit on the plot? 0 / 1
