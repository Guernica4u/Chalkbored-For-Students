const Explorer = {
  page: 0, selected: null, pageSize: 60,
  init() {
    $('#exSort').onchange = $('#exMin').onchange = () => { this.page = 0; this.render(); };
    $('#exSearch').oninput = () => { this.page = 0; this.render(); };
    $('#exPrev').onclick = () => { this.page = Math.max(0, this.page - 1); this.render(); };
    $('#exNext').onclick = () => { this.page++; this.render(); };
  },
  list(b) {
    const task = b.task, out = [];
    for (const [key, e] of b.table) {
      const st = task.stateFromKey(key);
      if (task.isTerminal(st)) continue;
      const legal = task.legalActions(st);
      let visits = 0, best = -Infinity, worst = Infinity, bestA = legal[0];
      for (const a of legal) {
        visits += e.n[a];
        if (e.q[a] > best) { best = e.q[a]; bestA = a; }
        worst = Math.min(worst, e.q[a]);
      }
      out.push({ key, st, e, legal, visits, best, worst, bestA });
    }
    return out;
  },
  render() {
    const b = activeBrain(), task = b.task;
    $('#explorerWho').textContent = `— ${b.name}`;
    let list = this.list(b);
    const total = list.length, totalVisits = list.reduce((s, x) => s + x.visits, 0);
    const minV = +$('#exMin').value, q = $('#exSearch').value.trim();
    list = list.filter(x => x.visits >= minV && (!q || x.key.includes(q)));
    const sorters = {
      visits: (a, c) => c.visits - a.visits, best: (a, c) => c.best - a.best || c.visits - a.visits,
      worst: (a, c) => a.best - c.best || c.visits - a.visits, spread: (a, c) => (c.best - c.worst) - (a.best - a.worst),
      fresh: (a, c) => a.visits - c.visits,
    };
    list.sort(sorters[$('#exSort').value]);
    const pages = Math.max(1, Math.ceil(list.length / this.pageSize));
    this.page = clamp(this.page, 0, pages - 1);
    $('#exSummary').textContent = `${fmtInt(total)} positions known · ${fmtInt(totalVisits)} decisions of experience · showing ${fmtInt(list.length)}`;
    $('#exPage').textContent = `${this.page + 1}/${pages}`;
    const grid = $('#exGrid');
    grid.innerHTML = '';
    if (!list.length) grid.innerHTML = `<p class="muted">${total ? 'No positions match the filter.' : `${escapeHtml(b.name)} knows nothing yet. Play or train to fill its brain.`}</p>`;
    for (const x of list.slice(this.page * this.pageSize, (this.page + 1) * this.pageSize)) {
      const card = document.createElement('div');
      card.className = 'state-card' + (this.selected === x.key ? ' on' : '');
      const bd = document.createElement('div');
      const items = x.legal.map(a => ({ a, value: x.e.q[a], visits: x.e.n[a] }));
      task.render(bd, x.st, { mini: true, annotations: makeAnnotations(items, b.algorithm, task), highlight: x.visits ? x.bestA : null });
      card.appendChild(bd);
      const cap = document.createElement('div');
      if (task.caption) cap.innerHTML = `<b>${fmtInt(x.visits)}×</b> · ${escapeHtml(task.caption(x.key))}<br>best: ${escapeHtml(task.actionLabel(x.bestA))} ${fmtVal(x.best, b.algorithm)}`;
      else cap.innerHTML = `<b>${fmtInt(x.visits)}×</b> · ${task.impartial ? "mover's view" : escapeHtml(task.playerNames[x.st.p]) + ' to move'}<br>best: ${escapeHtml(task.actionLabel(x.bestA).replace(/^(corner|edge|center) /, ''))} ${fmtVal(x.best, b.algorithm)}`;
      card.appendChild(cap);
      card.onclick = () => { this.selected = x.key; this.render(); };
      grid.appendChild(card);
    }
    this.renderDetail(b);
  },
  renderDetail(b) {
    const box = $('#exDetail'), task = b.task;
    const e = this.selected && b.table.get(this.selected);
    if (!e) { box.innerHTML = `<h3>Position detail</h3><p class="muted">Click a position on the left to inspect it and teach ${escapeHtml(b.name)} directly.</p>`; return; }
    const st = task.stateFromKey(this.selected);
    const ev = b.evaluate(st);
    box.innerHTML = `<h3>Position detail <span class="mono muted small">${escapeHtml(this.selected)}</span></h3>
      <div class="replay-grid"><div class="replay-board"><div class="rp-b"></div></div><div class="small"></div></div>`;
    task.render($('.rp-b', box), st, { annotations: makeAnnotations(ev.items, b.algorithm, task) });
    const max = Math.max(1e-9, ...ev.items.map(i => i.value));
    $('.replay-grid > .small', box).innerHTML = `<p>${task.impartial ? 'Values for whoever moves' : escapeHtml(task.playerNames[st.p]) + ' to move'} · seen ${fmtInt(ev.visits)}×</p>
      <table class="opts"><tr><th>Move</th><th>${b.isMenace ? 'Beads' : 'Q'}</th><th></th><th>n</th><th>Teach</th></tr>` +
      ev.items.slice().sort((x, y) => y.value - x.value).map(i => `<tr><td>${escapeHtml(task.actionLabel(i.a))}</td><td class="mono">${fmtVal(i.value, b.algorithm)}</td>
        <td>${valueBar(i.value, b.algorithm, max)}</td><td class="mono">${i.visits}</td>
        <td><button class="small" data-a="${i.a}" data-g="1">👍</button><button class="small" data-a="${i.a}" data-g="0">👎</button></td></tr>`).join('') +
      `</table><div class="row" style="margin-top:8px"><button class="small danger" id="exForget">Forget this position</button></div>`;
    $$('[data-a]', box).forEach(btn => btn.onclick = () => {
      const u = b.teach(st, +btn.dataset.a, btn.dataset.g === '1');
      toast(describeUpdate(task, Object.assign(u, { why: 'teach', good: btn.dataset.g === '1', menace: b.isMenace })));
      markDirty(); this.render();
    });
    $('#exForget', box).onclick = () => { b.table.delete(this.selected); this.selected = null; markDirty(); this.render(); };
  },
};

