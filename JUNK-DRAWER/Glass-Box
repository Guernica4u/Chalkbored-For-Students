}
/** Top-down floor plan of the real logs, with loose joints and openings marked. */
function floorPlanSVG(ev, px = 260) {
  const S = 26, pad = 1, x0 = ev.plot.x - ev.plot.size / 2, y0 = ev.plot.y - ev.plot.size / 2;
  const xs = ev.walls.flatMap(w => [w.x1, w.x2]), ys = ev.walls.flatMap(w => [w.y1, w.y2]);
  const minx = Math.min(...xs) - pad, maxx = Math.max(...xs) + pad, miny = Math.min(...ys) - pad, maxy = Math.max(...ys) + pad;
  const W = (maxx - minx) * S, H = (maxy - miny) * S, X = x => (x - minx) * S, Y = y => (y - miny) * S;
  let s = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${W.toFixed(0)} ${H.toFixed(0)}" width="${px}" style="max-width:100%;background:#101010">`;
  for (let gx = Math.ceil(minx); gx <= maxx; gx++) s += `<line x1="${X(gx)}" y1="0" x2="${X(gx)}" y2="${H}" stroke="#1e1e1e"/>`;
  for (let gy = Math.ceil(miny); gy <= maxy; gy++) s += `<line x1="0" y1="${Y(gy)}" x2="${W}" y2="${Y(gy)}" stroke="#1e1e1e"/>`;
  for (const w of ev.walls) s += `<line x1="${X(w.x1)}" y1="${Y(w.y1)}" x2="${X(w.x2)}" y2="${Y(w.y2)}" stroke="#bdbdbd" stroke-width="${FOREST.WALL * S}" stroke-linecap="butt"/>`;
  ev.walls.forEach((w, i) => {
    if (i && w.door) s += `<text x="${X((w.x1 + w.ix) / 2 - WALL_DIRS[w.dir][0] * 0.45)}" y="${Y((w.y1 + w.iy) / 2 - WALL_DIRS[w.dir][1] * 0.45) + 4}" fill="#fff" font-size="11" text-anchor="middle" font-family="sans-serif">door</text>`;
    else if (i && w.gap > 0.03) s += `<circle cx="${X(w.x1)}" cy="${Y(w.y1)}" r="${6 + w.gap * 40}" fill="none" stroke="#fff" stroke-dasharray="3 3"/>`;
  });
  s += `<text x="6" y="${H - 6}" fill="#8c8c8c" font-size="11" font-family="sans-serif">1 square = 1 m · dashed circles = loose joints</text></svg>`;
  return s;
}
function starText(n) { return '★'.repeat(n) + '☆'.repeat(5 - n); }
