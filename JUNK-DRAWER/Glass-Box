  const notes = [];
  notes.push(area >= FOREST.FULL_SPACE ? `Roomy: ${area.toFixed(1)} m² inside.` : area >= 7 ? `Cosy: ${area.toFixed(1)} m² inside.` : area >= FOREST.MIN_SPACE ? `Cramped: only ${area.toFixed(1)} m² inside.` : `More of a doghouse: ${area.toFixed(1)} m² inside, too small to live in.`);
  if (!joints.length && !extraOpenings) notes.push('Every joint is tight. No draughts at all.');
  else notes.push(`${joints.length} loose joint${joints.length === 1 ? '' : 's'} (${Math.round(joints.reduce((s, w) => s + w.gap, 0) * 100)} cm of cracks)${extraOpenings ? ` and ${extraOpenings} extra opening${extraOpenings === 1 ? '' : 's'}` : ''} let the wind in.`);
  notes.push(hasDoor ? `Has a ${Math.round(doorWidth * 100)} cm doorway.` : 'No door! You would have to climb in over the wall.');
  return { closed, area, perimeter, logs: walls.length, leak, looseJoints: joints.length, crackCm: Math.round(joints.reduce((s, w) => s + w.gap, 0) * 100),
    extraOpenings, hasDoor, doorWidth, insulation, space, overall, stars: 1 + Math.round(overall * 4), notes };
}

class ForestEnv {
  constructor(names) {
