/* ---------- PLAY ---------- */
const Play = {
  session: null, token: 0, pending: null, lastAI: null, score: { you: 0, ai: 0, draw: 0 },
  init() {
    this.replay = new ReplayView($('#playReplay'), { perspective: w => this.perspective(w), onTeach: u => this.onReplayTeach(u) });
    $('#playNew').onclick = () => this.newGame();
    $('#playSide').onchange = () => this.newGame();
    $('#playHints').onchange = () => this.render();
    $('#playExplore').onchange = () => { if (this.session) this.session.players.forEach(p => { if (p.kind === 'brain') p.explore = $('#playExplore').checked; }); };
    $('#playLearn').onchange = () => { if (this.session) this.session.players.forEach(p => { if (p.kind === 'brain') p.learn = $('#playLearn').checked; }); };
    for (const id of ['#playHints', '#playExplore', '#playLearn', '#playDelay']) $(id).addEventListener('change', () => Settings.save());
  },
  perspective(w) { return w === this.humanSide ? 'You win! 🎉' : `${activeBrain().name} wins.`; },
  newGame() {
    if (isWorld()) return;
    const b = activeBrain(), task = b.task;
    const sideSel = $('#playSide');
    const prev = sideSel.value;
    sideSel.innerHTML = task.playerNames.map((n, i) => `<option value="${i}">${escapeHtml(n)}${i === 0 ? ' (first)' : ' (second)'}</option>`).join('');
    sideSel.value = prev === '1' ? '1' : '0';
    this.token++;
    this.humanSide = +sideSel.value;
    const human = { kind: 'human' };
    const ai = { kind: 'brain', brain: b, learn: $('#playLearn').checked, explore: $('#playExplore').checked };
    this.session = new GameSession(task, this.humanSide === 0 ? [human, ai] : [ai, human], { record: true, observer: b });
    this.pending = null; this.lastAI = null;
    $('#playLog').innerHTML = '';
    logItem($('#playLog'), `New game: you are ${escapeHtml(task.playerNames[this.humanSide])}, ${escapeHtml(b.name)} is ${escapeHtml(task.playerNames[1 - this.humanSide])}. ${escapeHtml(b.name)} has learned from ${fmtInt(b.stats.gamesPlayed)} games and knows ${fmtInt(b.table.size)} positions.`, 'sys');
    $('#playHint').textContent = task.hint || '';
    $('#playLegend').innerHTML = legendHtml(b.algorithm);
    showThought($('#playThought'), null, task, { empty: `${escapeHtml(b.name)}'s reasoning appears here on its turn.`, speaker: b.name,
      emptySimple: `Hi! I'm ${b.name}. ${b.stats.gamesPlayed ? `I've played ${fmtInt(b.stats.gamesPlayed)} games so far.` : "I only know the rules, I haven't learned anything yet."} I'll think out loud when it's my turn.` });
    this.replay.setGame(this.session);
    this.updateScore();
    this.advance();
  },
  advance() {
    const g = this.session, tok = this.token, b = activeBrain();
    if (g.over) return this.gameOver();
    if (g.currentPlayer.kind === 'human') { this.pending = null; this.render(); return; }
    const d = g.decide(true);
    d.say = speak(g.task, d, 'you');
    this.pending = d;
    this.render();
    showThought($('#playThought'), d, g.task, { title: `${b.name} is thinking`, thinking: true, playerTag: g.current, speaker: b.name });
    setTimeout(() => {
      if (tok !== this.token) return;
      const move = g.play(d.a, d);
      this.pending = null;
      this.lastAI = move;
      logMove($('#playLog'), g.task, move);
      logUpdates($('#playLog'), g.task, g.lastUpdates);
      showThought($('#playThought'), d, g.task, { title: `${b.name}'s last move`, playerTag: move.player, onTeach: good => this.teachLast(good), speaker: b.name });
      markDirty();
      this.replay.refresh();
      this.advance();
    }, +$('#playDelay').value);
  },
  humanMove(a) {
    const g = this.session;
    if (!g || g.over || g.currentPlayer.kind !== 'human') return;
    const move = g.play(a);
    logMove($('#playLog'), g.task, move);
    logUpdates($('#playLog'), g.task, g.lastUpdates);
    this.replay.refresh();
    this.advance();
  },
  teachLast(good) {
    const m = this.lastAI; if (!m) return;
    const br = m.valueBrain, task = this.session.task;
    const u = br.teach(m.state, m.a, good);
    Object.assign(u, { why: 'teach', good, menace: br.isMenace, mi: m.index });
    m.updates.push(u);
    if (this.session.over) m.after = br.evaluate(m.state).items;
    logItem($('#playLog'), escapeHtml(teachMessage(task, u)), 'teachlog');
    toast(teachMessage(task, u));
    markDirty(); this.replay.refresh();
  },
  onReplayTeach(u) { logItem($('#playLog'), escapeHtml(describeUpdate(this.session.task, u)), 'teachlog'); },
  gameOver() {
    const g = this.session, task = g.task, b = activeBrain();
    this.render();
    if (g.winner === -1) this.score.draw++; else if (g.winner === this.humanSide) this.score.you++; else this.score.ai++;
    this.updateScore();
    logItem($('#playLog'), `<b>${escapeHtml(resultText(task, g.winner, w => this.perspective(w)))}</b>`, 'sys');
    const said = endSpeech(task, g, 1 - this.humanSide, 'you');
    if (!App.advanced) logItem($('#playLog'), `<b>${escapeHtml(b.name)}</b>: ${escapeHtml(said)}`);
    const last = this.lastAI;
    showThought($('#playThought'), last ? last.decision : null, task, { title: `${b.name}'s last move`, playerTag: last ? last.player : null,
      onTeach: last ? good => this.teachLast(good) : null, speaker: b.name, say: said });
    if (g.lastUpdates.length) {
      logItem($('#playLog'), `${escapeHtml(b.name)} learns from the result:`, 'sys');
      logUpdates($('#playLog'), task, g.lastUpdates);
    }
    this.replay.follow = true; this.replay.refresh();
    markDirty();
  },
  updateScore() {
    $('#playScore').textContent = `You ${this.score.you} · ${activeBrain().name} ${this.score.ai} · Draws ${this.score.draw}`;
  },
  render() {
    const g = this.session; if (!g || isWorld()) return;
    const task = g.task, b = activeBrain();
    let annotations = {}, highlight = null, onAction = null;
    const last = g.moves.length ? g.moves[g.moves.length - 1].a : null;
    if (!g.over) {
      if (this.pending) {
        if (App.advanced || Settings.showRatings) annotations = makeAnnotations(this.pending.items, b.algorithm, task);
        highlight = this.pending.a;
      }
      else if (g.currentPlayer.kind === 'human') {
        onAction = a => this.humanMove(a);
        if ($('#playHints').checked) annotations = makeAnnotations(b.evaluate(g.state).items, b.algorithm, task);
      }
    }
    task.render($('#playBoard'), g.state, { annotations, highlight, onAction, lastAction: last });
    $('#playLegend').innerHTML = App.advanced || Object.keys(annotations).length ? legendHtml(b.algorithm) : '';
    $('#playStatus').textContent = g.over ? resultText(task, g.winner, w => this.perspective(w))
      : g.currentPlayer.kind === 'human' ? `Your move (${task.playerNames[this.humanSide]})` + ($('#playHints').checked ? (App.advanced ? ` — colours show ${b.name}'s opinion of your options` : ` — shades show what ${b.name} thinks of each move`) : '')
      : `${b.name} is thinking…`;
  },
};

