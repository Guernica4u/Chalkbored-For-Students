const HYPER_UI = [
  { k: 'alpha', label: 'Learning rate α', min: 0.01, max: 1, step: 0.01, algo: 'qlearning', help: 'How far each update moves a value toward its target.' },
  { k: 'gamma', label: 'Discount γ', min: 0, max: 1, step: 0.01, algo: 'qlearning', help: 'How much the value of the next position counts (future vs. now).' },
  { k: 'epsilon', label: 'Exploration ε', min: 0, max: 1, step: 0.01, algo: 'qlearning', help: 'Chance of a random move instead of the best known one. Decays every game.' },
  { k: 'epsilonDecay', label: 'ε decay / game', min: 0.99, max: 1, step: 0.0001, algo: 'qlearning', digits: 4 },
  { k: 'epsilonMin', label: 'ε minimum', min: 0, max: 0.5, step: 0.01, algo: 'qlearning' },
  { k: 'initialQ', label: 'Initial Q (optimism)', min: -1, max: 1, step: 0.05, algo: 'qlearning', help: 'Value of never-tried moves. Positive = optimistic = curious. Affects new positions only.' },
  { k: 'initialBeads', label: 'Initial beads', min: 1, max: 20, step: 1, algo: 'menace', help: 'Beads per move in a new matchbox. Affects new positions only.' },
  { k: 'winBeads', label: 'Beads added on win', min: 0, max: 10, step: 1, algo: 'menace' },
  { k: 'drawBeads', label: 'Beads added on draw', min: 0, max: 10, step: 1, algo: 'menace' },
  { k: 'lossBeads', label: 'Beads added on loss', min: -10, max: 0, step: 1, algo: 'menace', help: 'Negative = beads removed from every move played in a lost game.' },
];
const Train = {
  running: false, trainer: null, carry: 0, last: 0, goal: null, rateWin: [], uiT: 0, chartLen: -1,
  init() {
    $('#trainStart').onclick = () => this.start();
    $('#trainStop').onclick = () => this.stop();
    $('#train10k').onclick = () => this.start(10000);
    $('#train1k').onclick = () => this.start(1000);
    $('#trainSpeed').oninput = () => this.speedLabel();
    $('#trainOpp').onchange = () => { if (this.trainer) this.trainer.opponent = $('#trainOpp').value; };
    $('#hyperDefaults').onclick = () => {
      const b = activeBrain();
      for (const h of HYPER_UI) b.hyper[h.k] = DEFAULT_HYPER[h.k];
      markDirty(); this.renderHyper();
    };
    $('#brainResetBtn').onclick = () => {
      const b = activeBrain();
      if (!confirm(`Wipe ${b.name}'s brain? All ${fmtInt(b.table.size)} learned positions and stats will be erased.`)) return;
      this.stop(); b.reset(); markDirty(); this.render(); toast(`${b.name} forgot everything.`);
    };
    $('#trainOpenReplay').onclick = () => {
      if (!this.trainer || !this.trainer.lastGame) return toast('Train first — no game recorded yet.');
      $('#trainReplay').style.display = '';
      this.replay.setGame(this.trainer.lastGame);
      this.replay.idx = 0; this.replay.follow = false; this.replay.render();
      $('#trainReplay').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    };
    this.replay = new ReplayView($('#trainReplay'), { title: 'Last training game, step by step' });
    window.addEventListener('resize', () => { if (App.tab === 'train') drawChart($('#chart'), activeBrain().history); });
    this.speedLabel();
  },
  speed() { const v = +$('#trainSpeed').value; return v >= 100 || this.goal != null ? Infinity : Math.round(Math.pow(10, (v / 99) * 4)); },
  speedLabel() { const s = this.speed(); $('#trainSpeedLbl').textContent = s === Infinity ? 'MAX (as fast as possible)' : `${fmtInt(s)} games/sec`; },
  start(goal = null) {
    const b = activeBrain();
    if (!this.trainer || this.trainer.brain !== b) this.trainer = new Trainer(b);
    this.trainer.opponent = $('#trainOpp').value;
    this.goal = goal ? this.trainer.gamesThisRun + goal : null;
    if (!b.history.length) this.trainer.checkpoint();
    if (this.running) return;
    this.running = true; this.carry = 0; this.last = performance.now(); this.rateWin = [];
    $('#trainStart').disabled = true; $('#trainStop').disabled = false;
    this.tick();
  },
  /** Schedule the next slice. MessageChannel isn't frame-throttled like requestAnimationFrame, and each slice
      yields to the browser, so the UI stays responsive. Slow speeds use setTimeout to avoid spinning. */
  tick() {
    if (!this.chan) { this.chan = new MessageChannel(); this.chan.port1.onmessage = () => this.loop(); }
    if (this.speed() === Infinity) this.chan.port2.postMessage(0);
    else setTimeout(() => this.loop(), 16);
  },
  stop() {
    if (!this.running) return;
    this.running = false; this.goal = null;
    $('#trainStart').disabled = false; $('#trainStop').disabled = true;
    if (this.trainer && this.trainer.sinceEval > 50) this.trainer.checkpoint();
    markDirty(); saveAll();
    this.render();
  },
  loop() {
    if (!this.running) return;
    const now = performance.now(), dt = Math.min(250, now - this.last);
    this.last = now;
    const sp = this.speed(), tr = this.trainer;
    let target = sp === Infinity ? Infinity : sp * dt / 1000 + this.carry;
    if (this.goal != null) target = Math.min(target, this.goal - tr.gamesThisRun);
    const t0 = now;
    let done = 0;
    while (done < Math.floor(target) && performance.now() - t0 < 14) {
      const chunk = Math.min(25, Math.floor(target) - done);
      tr.runBatch(chunk, done + chunk >= Math.floor(target) || performance.now() - t0 > 12);
      done += chunk;
    }
    this.carry = sp === Infinity ? 0 : Math.min(target - done, sp * 0.25);
    this.rateWin.push([now, tr.gamesThisRun]);
    while (this.rateWin.length > 2 && now - this.rateWin[0][0] > 1500) this.rateWin.shift();
    if (done) markDirty();
    if (now - this.uiT > 120) { this.uiT = now; this.renderLive(); }
    if (this.goal != null && tr.gamesThisRun >= this.goal) { this.stop(); toast('Finished the training run.'); return; }
    this.tick();
  },
  render() {
    if (isWorld()) return;
    const b = activeBrain(), task = b.task;
    $('#trainWho').textContent = `— ${b.name} (${task.name}, ${ALGORITHMS[b.algorithm].name})`;
    const opp = $('#trainOpp'), prev = opp.value;
    if (!App.advanced) opp.innerHTML = `<option value="random">a random player</option><option value="self">itself</option>`;
    else opp.innerHTML = `<option value="random">Random mover</option><option value="self">Itself (self-play)</option>` +
      (task.solvable !== false ? `<option value="perfect">Perfect solver (hard mode)</option>` : '') +
      App.brains.filter(o => o !== b && o.taskId === b.taskId).map(o => `<option value="brain:${o.id}">${escapeHtml(o.name)} (frozen, no exploring)</option>`).join('');
    opp.value = [...opp.options].some(o => o.value === prev) ? prev : 'random';
    this.renderHyper();
    this.chartLen = -1;
    this.renderLive();
  },
  renderHyper() {
    const b = activeBrain();
    $('#hyperAlgo').textContent = ALGORITHMS[b.algorithm].name;
    const box = $('#hyperBox');
    box.innerHTML = HYPER_UI.filter(h => h.algo === b.algorithm).map(h => `
      <label for="hp-${h.k}">${h.label}</label>
      <input type="range" id="hp-${h.k}" data-k="${h.k}" min="${h.min}" max="${h.max}" step="${h.step}" value="${b.hyper[h.k]}">
      <span class="val" id="hpv-${h.k}">${(+b.hyper[h.k]).toFixed(h.digits || (h.step >= 1 ? 0 : 2))}</span>
      ${h.help ? `<div class="help">${h.help}</div>` : ''}`).join('');
    $$('input[type=range]', box).forEach(inp => inp.oninput = () => {
      const h = HYPER_UI.find(x => x.k === inp.dataset.k);
      activeBrain().hyper[h.k] = +inp.value;
      $('#hpv-' + h.k).textContent = (+inp.value).toFixed(h.digits || (h.step >= 1 ? 0 : 2));
      markDirty();
    });
  },
  renderLive() {
    if (isWorld()) return;
    const b = activeBrain(), st = b.stats, task = b.task;
    const rw = this.rateWin, span = rw.length > 1 ? rw[rw.length - 1][0] - rw[0][0] : 0;
    const gps = span > 0 ? (rw[rw.length - 1][1] - rw[0][1]) / span * 1000 : 0;
    $('#trainRate').textContent = this.running ? `${fmtInt(gps)} games/s · this run ${fmtInt(this.trainer.gamesThisRun)}` : (this.trainer ? `stopped · this run ${fmtInt(this.trainer.gamesThisRun)}` : '');
    const h = b.history[b.history.length - 1];
    const cell = (k, v, sub = '') => `<div class="metric"><div class="k">${k}</div><div class="v">${v}</div>${sub ? `<div class="small muted">${sub}</div>` : ''}</div>`;
    const vs = st.wins + st.losses + st.draws;
    $('#trainStats').innerHTML =
      cell('Games learned', fmtInt(st.gamesPlayed), `${fmtInt(st.selfPlayGames)} self-play`) +
      cell('W / L / D', `${fmtInt(st.wins)} / ${fmtInt(st.losses)} / ${fmtInt(st.draws)}`, vs ? `win ${fmtPct(st.wins / vs)} while learning` : 'vs other opponents') +
      cell('Positions known', fmtInt(b.table.size)) +
      (b.isMenace ? cell('Algorithm', 'MENACE', 'samples by beads') : cell('ε now', fmtPct(b.hyper.epsilon), `min ${fmtPct(b.hyper.epsilonMin)}`)) +
      cell('Test win % vs random', h ? fmtPct(h.win) : '—', h ? `loss ${fmtPct(h.loss)}, draw ${fmtPct(1 - h.win - h.loss)}` : 'after first checkpoint') +
      cell('Optimal moves', h && h.opt != null ? fmtPct(h.opt) : '—', 'agrees with perfect solver');
    $('#trainSimple').textContent = !st.gamesPlayed && !h
      ? `${b.name} hasn't practiced yet. It only knows the rules, so it plays like a random player. Press a button to let it practice.`
      : `${b.name} has played ${fmtInt(st.gamesPlayed)} games and remembers ${fmtInt(b.table.size)} board positions.` +
        (h ? ` In its latest test against a random player it won ${fmtPct(h.win)} and lost ${fmtPct(h.loss)} of the games. ` +
          (h.loss > 0.15 ? 'It still makes lots of mistakes.' : h.loss > 0.03 ? 'It is getting good, but still slips up sometimes.' : 'It almost never loses now.') : '') +
        (this.running ? ` Practicing... ${fmtInt(this.trainer.gamesThisRun)} games so far.` : '');
    if (!this.running) $$('#hyperBox input[type=range]').forEach(inp => { if (inp.dataset.k === 'epsilon') inp.value = b.hyper.epsilon; });
    const ev = $('#hpv-epsilon'); if (ev) ev.textContent = b.hyper.epsilon.toFixed(2);
    if (App.tab === 'train' && b.history.length !== this.chartLen) { this.chartLen = b.history.length; drawChart($('#chart'), b.history); }
    const g = this.trainer && this.trainer.brain === b ? this.trainer.lastGame : null;
    if (g) {
      task.render($('#trainLastBoard'), g.state, { lastAction: g.moves.length ? g.moves[g.moves.length - 1].a : null });
      const me = g.players.findIndex(p => p.kind === 'brain' && p.brain === b);
      const oppName = g.players[1 - me] ? playerLabel(g.players[1 - me]) : '';
      const explored = g.moves.filter(m => m.decision && m.decision.kind === 'explore').length;
      $('#trainLastInfo').innerHTML = `${escapeHtml(b.name)} as ${g.players[0] === g.players[1] ? 'both sides' : task.playerNames[me]} vs ${escapeHtml(g.players[0] === g.players[1] ? 'itself' : oppName)}<br>
        <b>${escapeHtml(resultText(task, g.winner))}</b> in ${g.moves.length} moves<br>${explored} exploratory move${explored === 1 ? '' : 's'}`;
    } else { $('#trainLastBoard').innerHTML = ''; $('#trainLastInfo').textContent = 'No training game yet.'; }
  },
};

function drawChart(canvas, hist) {
  const dpr = window.devicePixelRatio || 1, w = canvas.clientWidth, h = canvas.clientHeight;
  if (!w || !h) return;
  canvas.width = Math.round(w * dpr); canvas.height = Math.round(h * dpr);
  const c = canvas.getContext('2d');
  c.setTransform(dpr, 0, 0, dpr, 0, 0);
  c.clearRect(0, 0, w, h);
  const L = 42, R = 40, T = 10, B = 26, pw = w - L - R, ph = h - T - B;
  c.font = '11px system-ui, sans-serif'; c.lineWidth = 1;
  for (let i = 0; i <= 4; i++) {
    const y = T + ph - (ph * i) / 4;
    c.strokeStyle = App.advanced ? '#2b3340' : '#262626'; c.beginPath(); c.moveTo(L, y); c.lineTo(L + pw, y); c.stroke();
    c.fillStyle = '#8b95a3'; c.textAlign = 'right'; c.fillText(i * 25 + '%', L - 6, y + 4);
    if (!App.advanced) continue;
    c.textAlign = 'left'; c.fillStyle = '#d29922'; c.fillText((i / 2 - 1 > 0 ? '+' : '') + (i / 2 - 1).toFixed(1), L + pw + 6, y + 4);
  }
  if (hist.length < 2) {
    c.fillStyle = '#8b95a3'; c.textAlign = 'center'; c.font = '14px system-ui, sans-serif';
    c.fillText(App.advanced ? 'Press Start to train — the learning curve appears here.' : 'Let it practice, and its progress shows up here.', L + pw / 2, T + ph / 2);
    return;
  }
  const g0 = hist[0].g, g1 = Math.max(g0 + 1, hist[hist.length - 1].g);
  const X = g => L + ((g - g0) / (g1 - g0)) * pw;
  c.fillStyle = '#8b95a3';
  for (let i = 0; i <= 4; i++) {
    const g = g0 + ((g1 - g0) * i) / 4;
    c.textAlign = i === 0 ? 'left' : i === 4 ? 'right' : 'center';
    c.fillText(fmtInt(g) + (i === 4 ? ' games' : ''), L + (pw * i) / 4, h - 8);
  }
  const series = App.advanced ? [
    ['win', '#3fb950', v => v, false], ['loss', '#f85149', v => v, false], ['opt', '#58a6ff', v => v, false],
    ['avgR', '#d29922', v => (v + 1) / 2, true],
  ] : [['win', '#ffffff', v => v, false], ['loss', '#777777', v => v, true]];
  for (const [k, col, map, dashed] of series) {
    c.strokeStyle = col; c.lineWidth = 2; c.setLineDash(dashed ? [5, 4] : []);
    c.beginPath();
    let pen = false;
    for (const p of hist) {
      if (p[k] == null) { pen = false; continue; }
      const x = X(p.g), y = T + ph - clamp(map(p[k]), 0, 1) * ph;
      if (pen) c.lineTo(x, y); else c.moveTo(x, y);
      pen = true;
    }
    c.stroke();
  }
  c.setLineDash([]);
}

/* ---------- WATCH ---------- */
const Watch = {
  session: null, timer: 0, auto: false, pending: null, series: { 0: 0, 1: 0, d: 0 }, last: [null, null],
  init() {
    this.replay = new ReplayView($('#watchReplay'));
    $('#watchNew').onclick = () => this.newGame();
    $('#watchStep').onclick = () => { this.setAuto(false); this.step(); };
    $('#watchAuto').onclick = () => this.setAuto(!this.auto);
    $('#watchP0').onchange = $('#watchP1').onchange = () => { this.series = { 0: 0, 1: 0, d: 0 }; this.newGame(); };
    $('#watchLearn').onchange = $('#watchExplore').onchange = () => this.applyFlags();
  },
  setup() {
    if (isWorld()) return;
    const b = activeBrain(), task = b.task;
    const opts = App.brains.filter(o => o.taskId === b.taskId).map(o => `<option value="brain:${o.id}">${escapeHtml(o.name)}</option>`).join('') +
      `<option value="random">Random</option>` + (task.solvable !== false ? `<option value="perfect">Perfect solver</option>` : '');
    for (const i of [0, 1]) {
      const sel = $('#watchP' + i), prev = sel.value;
      sel.innerHTML = opts;
      $('#watchP' + i + 'Name').textContent = task.playerNames[i];
      if ([...sel.options].some(o => o.value === prev)) sel.value = prev;
      else {
        const others = App.brains.filter(o => o.taskId === b.taskId && o !== b);
        sel.value = i === 0 ? 'brain:' + b.id : others.length ? 'brain:' + others[0].id : 'brain:' + b.id;
      }
    }
    this.series = { 0: 0, 1: 0, d: 0 };
    this.newGame();
  },
  makePlayer(v) {
    if (v === 'random') return { kind: 'random' };
    if (v === 'perfect') return { kind: 'perfect' };
    const br = brainById(v.slice(6)) || activeBrain();
    return { kind: 'brain', brain: br, learn: $('#watchLearn').checked, explore: $('#watchExplore').checked };
  },
  applyFlags() {
    if (!this.session) return;
    for (const p of this.session.players) if (p.kind === 'brain') { p.learn = $('#watchLearn').checked; p.explore = $('#watchExplore').checked; }
  },
  newGame() {
    clearTimeout(this.timer);
    const task = activeBrain().task;
    const players = [this.makePlayer($('#watchP0').value), this.makePlayer($('#watchP1').value)];
    const observer = (players.find(p => p.kind === 'brain') || {}).brain || null;
    this.session = new GameSession(task, players, { record: true, observer });
    this.pending = null; this.last = [null, null]; this.endSay = null;
    $('#watchLog').innerHTML = '';
    logItem($('#watchLog'), `New game: ${escapeHtml(playerLabel(players[0]))} (${escapeHtml(task.playerNames[0])}) vs ${escapeHtml(playerLabel(players[1]))} (${escapeHtml(task.playerNames[1])}).`, 'sys');
    $('#watchLegend').innerHTML = observer ? legendHtml(observer.algorithm) : '';
    this.replay.setGame(this.session);
    this.render();
    if (this.auto) this.schedule();
  },
  setAuto(on) {
    this.auto = on;
    $('#watchAuto').textContent = on ? 'Pause ❚❚' : 'Auto ▶';
    clearTimeout(this.timer);
    if (on) this.schedule();
  },
  schedule() { clearTimeout(this.timer); this.timer = setTimeout(() => { this.step(); if (this.auto) this.schedule(); }, +$('#watchDelay').value); },
  step() {
    const g = this.session;
    if (!g) return;
    if (g.over) { this.newGame(); return; }
    if (!this.pending) {     // phase 1: think
      this.pending = g.decide(true);
      const me = playerLabel(g.currentPlayer), opp = playerLabel(g.players[1 - g.current]);
      this.pending.say = speak(g.task, this.pending, opp === me ? 'my twin' : opp === 'Perfect solver' ? 'the solver' : opp);
      this.render();
      return;
    }
    const d = this.pending; this.pending = null;   // phase 2: act
    const pi = g.current;
    const move = g.play(d.a, d);
    this.last[pi] = d;
    logMove($('#watchLog'), g.task, move);
    logUpdates($('#watchLog'), g.task, g.lastUpdates);
    if (g.over) {
      if (g.winner === -1) this.series.d++; else this.series[g.winner]++;
      logItem($('#watchLog'), `<b>${escapeHtml(this.resultLine())}</b>`, 'sys');
      this.endSay = [0, 1].map(i => {
        if (g.players[i].kind !== 'brain') return null;
        const me = playerLabel(g.players[i]), opp = playerLabel(g.players[1 - i]);
        return endSpeech(g.task, g, i, opp === me ? 'my twin' : opp === 'Perfect solver' ? 'the solver' : opp);
      });
      if (g.players.some(p => p.kind === 'brain' && p.learn)) markDirty();
    }
    this.replay.refresh();
    this.render();
  },
  resultLine() {
    const g = this.session, task = g.task;
    if (g.winner === -1) return 'Draw.';
    return `${playerLabel(g.players[g.winner])} (${task.playerNames[g.winner]}) wins!`;
  },
  render() {
    const g = this.session; if (!g || isWorld()) return;
    const task = g.task;
    const last = g.moves.length ? g.moves[g.moves.length - 1].a : null;
    const d = this.pending;
    const ann = d && (App.advanced || Settings.showRatings) ? makeAnnotations(d.items, d.algo, task) : {};
    task.render($('#watchBoard'), g.state, { annotations: ann, highlight: d ? d.a : null, lastAction: last });
    $('#watchStatus').textContent = g.over ? this.resultLine()
      : d ? `${d.playerName} (${task.playerNames[g.current]}) wants to play ${App.advanced ? task.actionLabel(d.a) : sayMove(task, d.a)} — Step to confirm`
      : `${playerLabel(g.currentPlayer)} (${task.playerNames[g.current]}) to move`;
    for (const i of [0, 1]) {
      const showing = d && g.current === i && !g.over ? d : this.last[i];
      showThought($('#watchThought' + i), showing, task, {
        title: `${task.playerNames[i]} · ${playerLabel(g.players[i])}`, playerTag: i, thinking: showing === d && !!d,
        empty: 'No move yet.', speaker: `${playerLabel(g.players[i])} (${task.playerNames[i]})`,
        say: g.over && this.endSay ? this.endSay[i] || undefined : undefined,
      });
    }
    const p0 = playerLabel(g.players[0]), p1 = playerLabel(g.players[1]);
    $('#watchSeries').textContent = `Series: ${p0} ${this.series[0]} – ${this.series[1]} ${p1} · draws ${this.series.d}`;
  },
};

