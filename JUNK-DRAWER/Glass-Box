/** Merge: Q-values averaged, weighted by visit counts; visit counts and stats are summed. */
function mergeBrain(target, data) {
  if (target.taskId !== data.taskId) throw new Error('Task mismatch');
  if (target.algorithm !== data.algorithm) throw new Error('Algorithm mismatch');
  const task = target.task;
  let changed = 0;
  for (const [key, arr] of data.table) {
    const e = target.entry(key, task.stateFromKey(key));
    for (let i = 0; i < arr.length; i += 3) {
      const a = arr[i], q2 = arr[i + 1], n2 = arr[i + 2], q1 = e.q[a], n1 = e.n[a], tot = n1 + n2;
