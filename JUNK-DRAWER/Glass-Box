function brainToJSON(brain) {
  const task = brain.task, def = brain.defaultValue, table = {};
  for (const [key, e] of brain.table) {
    const st = task.stateFromKey(key);
    if (task.isTerminal(st)) continue;
    const arr = [];
    for (const a of task.legalActions(st)) {
      if (e.n[a] === 0 && e.q[a] === def) continue;
      arr.push(a, round4(e.q[a]), e.n[a]);
    }
    if (arr.length) table[key] = arr;
  }
  return {
    format: FORMAT_NAME, formatVersion: FORMAT_VERSION, app: APP_NAME, exportedAt: new Date().toISOString(),
    name: brain.name, taskId: brain.taskId, taskVersion: task.version, algorithm: brain.algorithm,
    brainRevision: brain.revision,
    hyperparameters: Object.assign({}, brain.hyper),
    stats: Object.assign({}, brain.stats),
    history: brain.history.map(p => [p.g, p.win, p.loss, p.opt, p.avgR].map(v => (v == null ? null : round4(v)))),
    table,
    checksum: fnv1a(JSON.stringify(table)),
