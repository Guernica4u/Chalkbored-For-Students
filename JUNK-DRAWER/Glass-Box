    for (const i of items) {
      const share = total > 0 ? i.value / total : 0;
      ann[i.a] = { color: heatColor(max > 0 ? (i.value / max) * 2 - 1 : 0, i.visits > 0 || i.value !== max),
        main: String(Math.round(i.value)), sub: fmtPct(share),
        title: `${task.actionLabel(i.a)}: ${Math.round(i.value)} beads (${fmtPct(share)} chance), used ${i.visits}×` };
    }
