    for (let pi = 0; pi < 2; pi++) {
      const p = this.players[pi];
      if (p.kind !== 'brain' || !p.learn) continue;
      const b = p.brain, r = task.reward(s, pi);
      learners.add(b);
      if (b.isMenace) {
        const ups = b.menaceUpdate(this.traj[pi], r);
        if (this.record) for (const u of ups) { u.why = 'beads'; u.player = pi; this.moves[u.mi].updates.push(u); this.lastUpdates.push(u); }
      } else if (this.pending[pi]) {
        const pend = this.pending[pi];
        const u = b.tdUpdate(pend.key, pend.state, pend.a, r);
        if (this.record) {
          Object.assign(u, { why: 'terminal', reward: r, alpha: b.hyper.alpha, mi: pend.mi, player: pi });
          this.moves[pend.mi].updates.push(u); this.lastUpdates.push(u);
        }
      }
      this.pending[pi] = null;
    }
    const lb = pi => (this.players[pi].kind === 'brain' && this.players[pi].learn ? this.players[pi].brain : null);
    const b0 = lb(0), b1 = lb(1);
    if (b0 && b0 === b1) { b0.stats.gamesPlayed++; b0.stats.selfPlayGames++; }
