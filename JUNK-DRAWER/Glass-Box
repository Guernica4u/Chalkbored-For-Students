    const h = FOREST.WALL / 2;
    const [i0, j0] = cell(Math.min(w.x1, w.x2) - h, Math.min(w.y1, w.y2) - h), [i1, j1] = cell(Math.max(w.x1, w.x2) + h, Math.max(w.y1, w.y2) + h);
    for (let j = Math.max(0, j0); j <= Math.min(N - 1, j1); j++) for (let i = Math.max(0, i0); i <= Math.min(N - 1, i1); i++) wood[j * N + i] = 1;
  }
  /** square max/min filter of radius R, done row-wise then column-wise */
  const filter = (src, grow) => {
    const a = new Uint8Array(N * N), b = new Uint8Array(N * N);
    for (let j = 0; j < N; j++) for (let i = 0; i < N; i++) {
      let v = grow ? 0 : 1;
      for (let k = -R; k <= R; k++) { const ii = i + k, x = ii >= 0 && ii < N ? src[j * N + ii] : 0; if (grow ? x : !x) { v = grow ? 1 : 0; break; } }
      a[j * N + i] = v;
    }
    for (let j = 0; j < N; j++) for (let i = 0; i < N; i++) {
      let v = grow ? 0 : 1;
      for (let k = -R; k <= R; k++) { const jj = j + k, x = jj >= 0 && jj < N ? a[jj * N + i] : 0; if (grow ? x : !x) { v = grow ? 1 : 0; break; } }
      b[j * N + i] = v;
    }
    return b;
  };
  const block = filter(filter(wood, true), false);   // morphological closing: small gaps sealed, shapes otherwise unchanged
