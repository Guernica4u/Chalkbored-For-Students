  const stack = [];
  for (let i = 0; i < N; i++) for (const j of [0, N - 1]) { stack.push(j * N + i, i * N + j); }
  while (stack.length) {
    const c = stack.pop();
    if (outside[c] || block[c]) continue;
    outside[c] = 1;
    const i = c % N, j = (c - i) / N;
    if (i > 0) stack.push(c - 1); if (i < N - 1) stack.push(c + 1); if (j > 0) stack.push(c - N); if (j < N - 1) stack.push(c + N);
  }
  let inside = 0;
  for (let c = 0; c < N * N; c++) if (!outside[c] && !wood[c]) inside++;
