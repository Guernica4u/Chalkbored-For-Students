const ForestTask = registerTask({
  id: 'forest', name: 'Forest', version: 1, kind: 'world', impartial: true, solvable: false,
  numActions: FOREST_MOVES.length, playerNames: ['agent'],
  initialState() { return { key: 'D0000000' }; },
  getState(s) { return s.key; },
  currentPlayer() { return 0; },
  legalActions(s) {
    const k = s && s.key;
