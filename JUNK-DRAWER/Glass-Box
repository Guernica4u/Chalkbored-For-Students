    if (k[0] === 'P') return k[4] === '0' ? PLACE_ACTIONS.slice() : [5, 6, 7];   // a house gets one doorway
    const axe = k[1] === '1', stick = k[2] === '1', stone = k[3] === '1', log = k[4] === '1';
    const out = [0, 1, 3];
    if (stick && stone && !axe) out.push(2);
    if (!log && k[5] === '1') out.push(4);
    if (k[6] === '1') out.push(9);
