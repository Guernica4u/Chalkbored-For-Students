      t.className = 'rs-tile' + (opts.highlight === a ? ' chosen' : '');
      paintAnnotation(t, ann[a], mini);
      if (!mini) t.innerHTML = `<span class="rs-name">${FOREST_SHORT[a]}</span>` + (ann[a] ? `<span class="qv">${ann[a].main}</span>` : '');
