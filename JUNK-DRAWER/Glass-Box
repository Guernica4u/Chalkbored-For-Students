const FOREST = { W: 22, H: 15, AGENT: 0.8, REACH: 0.55, SPEED: 1.6, TURN: 5, TREES: 22, STICKS: 7, STONES: 6,
  TRUNK: 0.6, CANOPY: 0.75, TREE_HP: 4, LOGS_PER_TREE: 2, AXE_USES: 12, SLOTS: 3, LOG_LEN: 1, WALL: 0.25, DOOR: 0.9,
  PLOT: 10, ROUND: 600, CHOP_TIME: 0.7, PLACE_TIME: 1, FIX_TIME: 2, CRAFT_TIME: 2, PICK_TIME: 0.4, NOISE: 0.05,
  REGROW: 60, RESPAWN: 15, WIN_PAUSE: 3, FULL_SPACE: 12, MIN_SPACE: 2 };
