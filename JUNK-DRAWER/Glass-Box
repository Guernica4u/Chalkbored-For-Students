      e.n[a] = Math.min(0xffffffff, tot);
      changed++;
    }
  }
  for (const k of ['gamesPlayed', 'wins', 'losses', 'draws', 'selfPlayGames', 'taughtMoves']) target.stats[k] += data.stats[k] || 0;
  target.revision++; target.bench = null;
  return changed;
}

