  'place a log straight on', 'place a log turning left', 'place a log turning right', 'place a log leaving a doorway',
  'tighten the last joint', 'drop something', 'wait', 'go and place a log'];
const FOREST_SHORT = ['stick', 'stone', 'make axe', 'chop', 'get log', 'straight', 'left', 'right', 'doorway', 'tighten', 'drop', 'wait', 'place log'];
const DO_ACTIONS = [0, 1, 2, 3, 4, 9, 10, 12], PLACE_ACTIONS = [5, 6, 7, 8];   // (11 'wait' is kept for old files but no longer offered)
const ITEM_SLOTS = { stick: 1, stone: 1, axe: 1, log: 2 };
